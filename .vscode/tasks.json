{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Storefront (Next.js)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/apps/storefront-web-mobile"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Start Storefront Desktop (Electron)",
      "type": "shell",
      "command": "npm run desktop",
      "options": {
        "cwd": "${workspaceFolder}/apps/storefront-web-mobile"
      },
      "problemMatcher": []
    },
    {
      "label": "Build All (Master Script)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/build-all.ps1",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Verify AI API Keys",
      "type": "shell",
      "command": "npm run verify:ai",
      "options": {
        "cwd": "${workspaceFolder}/apps/storefront-web-mobile"
      },
      "problemMatcher": []
    }
  ]
}

<Project>
  <PropertyGroup>
    <Company>NextGenOS</Company>
    <Product>Smart Retail POS Business Hub</Product>
    <Copyright>© 2026 NextGenOS. All rights reserved.</Copyright>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- Language data is ON (the Business Hub carries its own copy, see NextGenOS.Hub.Web.csproj), because the SQL Server client used to move a shop across from an older system refuses to run without it.
         The programs still use the neutral ("invariant") culture for every number and date they write (HubHost.CreateBuilder), so nothing depends on the PC's own settings. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>

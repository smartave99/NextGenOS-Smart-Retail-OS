<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Business Hub's domain: shop settings, items, parties, documents (invoices, quotes, orders), payments, stock, and the workflows of each
       kind of business (counter sales, restaurant tables and kitchen, library loans, construction projects, appointments). Data lives in one SQLite
       file per shop. Money is whole minor units; every tax figure comes from NextGenOS.Tax and the country pack. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NextGenOS.Hub</RootNamespace>
    <AssemblyName>NextGenOS.Hub.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- The SQLite engine itself: newer than the one Microsoft.Data.Sqlite pulls in, which has a known vulnerability. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <!-- Reads the older POS's SQL Server database (Import/, read-only). MIT; the version the dashboard already uses. Its notice is in THIRD-PARTY-NOTICES.md. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <ProjectReference Include="..\..\..\..\libs\dotnet\NextGenOS.Tax\NextGenOS.Tax.csproj" />
    <ProjectReference Include="..\..\..\..\libs\dotnet\NextGenOS.Devices\NextGenOS.Devices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests reach the update steps directly, to prove that a step that fails leaves the shop as it was. -->
    <InternalsVisibleTo Include="NextGenOS.Hub.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\industry-packs\packs\*.json" LogicalName="NextGenOS.Hub.industries.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Data\Migrations\*.sql" LogicalName="NextGenOS.Hub.migrations.%(Filename)%(Extension)" />
    <!-- The way back from each migration, for HubDb.Rollback (a different name prefix, so that the migrations loader never sees them). -->
    <EmbeddedResource Include="Data\Rollbacks\*.sql" LogicalName="NextGenOS.Hub.rollbacks.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

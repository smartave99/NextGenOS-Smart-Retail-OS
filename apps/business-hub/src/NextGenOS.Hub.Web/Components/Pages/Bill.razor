@page "/documents/{Id:long}"
@attribute [Authorize(Policy = HubHost.DocumentsPolicy)]
@inherits HubPage
@inject IJSRuntime Js

<PageTitle>@(view?.Document.Number ?? "Bill")</PageTitle>
@if (view is null)
{
    <h1>Not found</h1>
    <Notice Error="@Error" />
    <a class="btn primary" href="documents">Back to the list</a>
}
else
{
    var d = view.Document;
    <div class="no-print">
        <p><a href="documents">← @Shop.Plural("invoice")</a></p>
        <h1>@Kind() @(d.Number ?? "")</h1>
        <p class="sub">
            @(d.IssuedAt is { } at ? When(at) : "Not finished") ·
            @if (view.Party is { } p) { <a href="account/@p.Id">@p.Name</a> }
            @if (d.Type == DocTypes.Quote && d.Meta.TryGetValue("billedAs", out var billedAs)) { <span class="chip ok">Made into bill @billedAs</span> }
            @if (d.Status == DocStatus.Void) { <span class="chip bad">Void</span> }
            else if (d.Status == DocStatus.Issued) { <span class="chip @(d.PaymentState == "paid" ? "ok" : "warn")">@(d.PaymentState == "paid" ? "Paid" : d.PaymentState == "partial" ? "Part paid" : "Unpaid")</span> }
        </p>
        <Notice Error="@Error" Info="@Info" />
        <div class="row wrap">
            <button type="button" class="btn primary" id="print" @onclick="Print"><Icon Name="print" />Print</button>
            <span class="layout-choice" role="group" aria-label="How the bill looks">
                <a class="chip-btn @(Layout == "receipt" ? "on" : "")" id="layout-receipt" href="documents/@Id?layout=receipt"><Icon Name="receipt" />Receipt</a>
                <a class="chip-btn @(Layout == "a4" ? "on" : "")" id="layout-a4" href="documents/@Id?layout=a4"><Icon Name="page" />Full page A4</a>
                <a class="chip-btn @(Layout == "a5" ? "on" : "")" id="layout-a5" href="documents/@Id?layout=a5"><Icon Name="page" />Full page A5</a>
            </span>
            @if (receiptPrinter is not null) { <button type="button" class="btn secondary" id="print-receipt" @onclick="PrintReceipt">Print on @receiptPrinter.Name</button> }
            @if (d.BalanceMinor > 0 && Me.Can(Perm.Sell)) { <button type="button" class="btn secondary" id="take-payment" @onclick="() => Toggle(PayPanel)">Take payment (@Money(d.BalanceMinor) owed)</button> }
            @if (d is { Type: DocTypes.Quote, Status: DocStatus.Issued, ProjectId: null } && !d.Meta.ContainsKey("billedAs") && Me.Can(Perm.Sell)) { <a class="btn secondary" id="make-bill" href="sell?estimate=@d.Id">Make a bill from this quote</a> }
            @if (CanReturn()) { <button type="button" class="btn secondary" id="give-back" @onclick="OpenReturn"><Icon Name="undo" />Take something back</button> }
            @if (CanSendBack()) { <button type="button" class="btn secondary" id="send-back" @onclick="OpenSendBack">Send goods back</button> }
            @if (CanPrintLabels()) { <a class="btn secondary" id="delivery-labels" href="/items/changes?delivery=@Id">Print labels for what came</a> }
            @if (CanVoid()) { <button type="button" class="btn danger" id="void" @onclick="() => Toggle(VoidPanel)"><Icon Name="cross" />Cancel this bill</button> }
        </div>

        @if (panel == PayPanel)
        {
            <div class="card">
                <h2>Take payment</h2>
                <div class="inline-form">
                    <div><label for="pay-method">Paid by</label><select id="pay-method" @bind="payMethod">@foreach (var m in Shop.PaymentMethods) { <option value="@m">@m</option> }</select></div>
                    <div><label for="pay-amount">Amount</label><input id="pay-amount" inputmode="decimal" @bind="payAmount" placeholder="@Shop.Text(d.BalanceMinor)" /></div>
                    <div><label for="pay-ref">Reference (optional)</label><input id="pay-ref" @bind="payRef" maxlength="60" /></div>
                    <button type="button" class="btn primary" id="save-payment" @onclick="SavePayment">Save</button>
                </div>
            </div>
        }
        @if (panel == ReturnPanel)
        {
            <div class="card">
                <h2>Take something back</h2>
                <table class="tbl">
                    <thead><tr><th>Item</th><th class="num">Bought</th><th class="num">Giving back</th></tr></thead>
                    <tbody>
                    @foreach (var l in view.Lines)
                    {
                        <tr><td>@l.Description</td><td class="num">@Qty(l.QtyMilli)</td><td class="num"><input class="qty" inputmode="decimal" aria-label="Giving back: @l.Description" @bind="returns[l.Id]" /></td></tr>
                    }
                    </tbody>
                </table>
                <div class="inline-form">
                    <div><label for="r-why">Why</label><input id="r-why" @bind="reason" maxlength="120" /></div>
                    <div><label for="r-kind">The money</label><select id="r-kind" @bind="keepAsCredit"><option value="@false">goes back now</option>@if (view.Party is not null) { <option value="@true">stays as credit on the customer's account</option> }</select></div>
                    @if (!keepAsCredit) { <div><label for="r-how">Money goes back by</label><select id="r-how" @bind="refundMethod">@foreach (var m in Shop.PaymentMethods) { <option value="@m">@m</option> }</select></div> }
                    <button type="button" class="btn primary" id="save-return" @onclick="SaveReturn">Give back</button>
                </div>
            </div>
        }
        @if (panel == SendBackPanel)
        {
            <div class="card" id="send-back-panel">
                <h2>Send goods back to the supplier</h2>
                <p class="muted small">The goods leave the stock at what they cost, the tax paid on them is taken back, and what you owe @(view.Party?.Name ?? "the supplier") goes down by the total. The credit is put against what is still unpaid on this purchase first.</p>
                <table class="tbl">
                    <thead><tr><th>Item</th><th class="num">Received</th><th class="num">Sending back</th></tr></thead>
                    <tbody>
                    @foreach (var l in view.Lines)
                    {
                        <tr><td>@l.Description</td><td class="num">@Qty(l.QtyMilli)</td><td class="num"><input class="qty" inputmode="decimal" aria-label="Sending back: @l.Description" @bind="returns[l.Id]" /></td></tr>
                    }
                    </tbody>
                </table>
                <div class="inline-form">
                    <div><label for="sb-why">Why</label><input id="sb-why" @bind="reason" maxlength="120" /></div>
                    <div><label for="sb-kind">What is paid for them</label><select id="sb-kind" @bind="supplierPaysBack"><option value="@false">stays as credit with the supplier</option><option value="@true">the supplier pays back now, for what is already paid</option></select></div>
                    @if (supplierPaysBack) { <div><label for="sb-how">Paid back by</label><select id="sb-how" @bind="refundMethod">@foreach (var m in Shop.PaymentMethods) { <option value="@m">@m</option> }</select></div> }
                    <button type="button" class="btn primary" id="save-send-back" @onclick="SaveSendBack">Send them back</button>
                </div>
            </div>
        }
        @if (panel == VoidPanel)
        {
            <div class="card">
                <h2>Cancel this bill</h2>
                <p class="muted">The bill stays in the list as void and the stock goes back. Money taken is given back.</p>
                <div class="inline-form">
                    <div><label for="v-why">Why</label><input id="v-why" @bind="reason" maxlength="120" /></div>
                    <button type="button" class="btn danger" id="save-void" @onclick="SaveVoid">Cancel the bill</button>
                </div>
            </div>
        }
    </div>

    @if (Layout == "receipt")
    {
        <Receipt View="view" Shop="Shop" Points="@Points()" Offers="@App.Offers.ForDocument(Id)" Batches="@BatchesOnBill()" />
    }
    else
    {
        <TaxInvoice View="view" Shop="Shop" Paper="@Layout" Offers="@App.Offers.ForDocument(Id)" Batches="@BatchesOnBill()" />
    }

    @if (credits.Count > 0)
    {
        <div class="card no-print">
            <h2>@(view.Document.Type == DocTypes.Purchase ? "Goods sent back for this purchase" : "Credit notes for this bill")</h2>
            @foreach (var c in credits) { <div><a href="documents/@c.Id">@c.Number</a> · @When(c.IssuedAt ?? c.CreatedAt) · @Money(c.TotalMinor)</div> }
        </div>
    }
}

@code {
    [Parameter] public long Id { get; set; }

    /// <summary>"receipt", "a4" or "a5" for this one bill (the buttons above the bill); without it the shop's own choice in Settings is used.</summary>
    [SupplyParameterFromQuery(Name = "layout")] public string? LayoutChoice { get; set; }

    private string Layout => LayoutChoice is "receipt" or "a4" or "a5" ? LayoutChoice : Shop.Settings.BillLayout is "a4" or "a5" ? Shop.Settings.BillLayout : "receipt";

    /// <summary>Set by the screens that just finished a bill: the bill is printed by itself if a printer is set to.</summary>
    [SupplyParameterFromQuery(Name = "new")] public bool JustMade { get; set; }

    private NextGenOS.Devices.Printing.PrinterProfile? receiptPrinter;
    private bool autoDone;

    private DocumentView? view;
    private IReadOnlyList<NextGenOS.Hub.Documents.Document> credits = Array.Empty<Document>();
    private string? panel;
    private string payMethod = "cash", payAmount = "", payRef = "", reason = "", refundMethod = "cash";
    private readonly Dictionary<long, string> returns = new();

    private long loaded;

    protected override async Task OnParametersSetAsync()
    {
        // Going from a bill to its credit note keeps this same screen: read the other bill.
        if (loaded != 0 && loaded != Id)
        {
            panel = null;
            Error = Info = null;
            await Reload();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (JustMade && !autoDone && view is not null && App.Printing.AutoPrinter() is { } auto)
        {
            autoDone = true;
            await Run(async () => { await App.Printing.PrintBillAsync(Id, auto.Id, Me.Id); Info = $"Printed on {auto.Name}."; });
        }
    }

    protected override Task LoadAsync()
    {
        receiptPrinter = App.PrinterProfiles.For("receipt");
        loaded = Id;
        view = App.Documents.Get(Id);
        if (view is null) return Task.CompletedTask;
        payMethod = Shop.PaymentMethods.Contains("cash") ? "cash" : Shop.PaymentMethods[0];
        refundMethod = payMethod;
        credits = view.Document.Type == DocTypes.Invoice ? App.Documents.List(new DocumentFilter { Type = DocTypes.CreditNote, Limit = 200 }).Where(c => c.RefDocumentId == Id).ToList()
            : view.Document.Type == DocTypes.Purchase ? App.Documents.List(new DocumentFilter { Type = DocTypes.DebitNote, Limit = 200 }).Where(c => c.RefDocumentId == Id).ToList() : Array.Empty<Document>();
        returns.Clear();
        foreach (var l in view.Lines) returns.TryAdd(l.Id, "");
        return Task.CompletedTask;
    }

    private string Kind() => view!.Document.Type switch
    {
        DocTypes.Invoice => Shop.Singular("invoice"), DocTypes.CreditNote => "Credit note", DocTypes.DebitNote => "Debit note", DocTypes.Quote => "Quote", DocTypes.Order => "Order", DocTypes.Purchase => "Purchase", DocTypes.ProgressBill => "Progress bill", _ => "Bill",
    };

    private bool CanReturn() => view!.Document is { Type: DocTypes.Invoice, Status: DocStatus.Issued } && Me.Can(Perm.Sell);

    /// <summary>The batches the goods of this bill came from, for those who may see stock (null for anyone else).</summary>
    private IReadOnlyList<NextGenOS.Hub.Catalog.BatchOnBill>? BatchesOnBill() =>
        view!.Document.Type is DocTypes.Invoice or DocTypes.Purchase && (Me.Can(Perm.Sell) || Me.Can(Perm.Stock) || Me.Can(Perm.Reports) || Me.Can(Perm.Purchases)) ? AsMe(() => App.Batches.OnBill(Id)) : null;

    private bool CanPrintLabels() => view!.Document is { Type: DocTypes.Purchase, Status: DocStatus.Issued } && Me.Can(Perm.Catalog);

    private bool CanSendBack() => view!.Document is { Type: DocTypes.Purchase, Status: DocStatus.Issued } && Me.Can(Perm.Purchases);

    private bool CanVoid() => view!.Document is { Status: DocStatus.Issued } && view.Document.Type is DocTypes.Invoice && Me.Can(Perm.Void);

    private async Task Print() => await Js.InvokeVoidAsync("hub.print");

    private Task PrintReceipt() => Run(async () =>
    {
        await App.Printing.PrintBillAsync(Id, receiptPrinter!.Id, Me.Id);
        Info = $"Printed on {receiptPrinter.Name}.";
    });

    private bool keepAsCredit;
    private bool supplierPaysBack;

    private NextGenOS.Hub.Loyalty.LoyaltyService.Summary? Points() => view?.Party is { } p && App.Loyalty.Enabled ? App.Loyalty.ForDocument(Id, p.Id) : null;

    private const string PayPanel = "pay", ReturnPanel = "return", VoidPanel = "void", SendBackPanel = "send-back";

    private void Toggle(string name) => panel = panel == name ? null : name;

    private void OpenReturn()
    {
        Toggle(ReturnPanel);
        reason = "";
    }

    private void OpenSendBack()
    {
        Toggle(SendBackPanel);
        reason = "";
        supplierPaysBack = false;
    }

    private Task SaveSendBack() => Run(() =>
    {
        var back = new List<(long LineId, long QtyMilli)>();
        foreach (var l in view!.Lines)
        {
            var text = returns[l.Id].Trim();
            if (text.Length == 0) continue;
            long milli;
            try { milli = ShopContext.QtyMilli(text); } catch (FormatException) { throw new HubException("qty", $"Please type a number for {l.Description}."); }
            if (milli > 0) back.Add((l.Id, milli));
        }
        if (back.Count == 0) throw new HubException("nothing", "Type how many of each are going back.");
        var note = App.Documents.CreateDebitNote(Id, back, string.IsNullOrWhiteSpace(reason) ? "Sent back" : reason.Trim(), supplierPaysBack ? refundMethod : null, Me.Id);
        Nav.NavigateTo("/documents/" + note.Document.Id);
    });

    private Task SavePayment() => Run(() =>
    {
        long amount = view!.Document.BalanceMinor;
        if (payAmount.Trim().Length > 0 && (!TryMoney(Shop, payAmount, out amount) || amount <= 0)) throw new HubException("amount", "Please type the amount as a number, like 250 or 99.50.");
        view = App.Documents.AddPayment(Id, new PaymentInput { Method = payMethod, AmountMinor = amount, Reference = string.IsNullOrWhiteSpace(payRef) ? null : payRef.Trim() }, Me.Id);
        panel = null;
        payAmount = payRef = "";
    }, "Payment saved.");

    private Task SaveReturn() => Run(() =>
    {
        var credit = new List<(long LineId, long QtyMilli)>();
        foreach (var l in view!.Lines)
        {
            var text = returns[l.Id].Trim();
            if (text.Length == 0) continue;
            long milli;
            try { milli = ShopContext.QtyMilli(text); } catch (FormatException) { throw new HubException("qty", $"Please type a number for {l.Description}."); }
            if (milli > 0) credit.Add((l.Id, milli));
        }
        if (credit.Count == 0) throw new HubException("nothing", "Type how many of each are coming back.");
        if (keepAsCredit && view.Party is null) throw new HubException("no-party", "Credit on an account needs a customer on the bill.");
        var note = App.Documents.CreateCreditNote(Id, credit, string.IsNullOrWhiteSpace(reason) ? "Returned" : reason.Trim(), refundMethod, Me.Id, refundPaid: !keepAsCredit);
        Nav.NavigateTo("/documents/" + note.Document.Id);
    });

    private Task SaveVoid() => Run(() =>
    {
        App.Documents.Void(Id, reason, Me.Id, refundMethod);
        view = App.Documents.Get(Id);
        panel = null;
    }, "The bill is cancelled.");
}

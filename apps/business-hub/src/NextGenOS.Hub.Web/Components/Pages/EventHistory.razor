@page "/settings/events"
@attribute [Authorize(Policy = Perm.Ai)]
@inherits HubPage
@using System.Globalization
@using NextGenOS.Hub.Ai
@using NextGenOS.Hub.Events
@using NextGenOS.Hub.Intelligence
@using NextGenOS.Hub

<PageTitle>Business events</PageTitle>
<h1>Business events</h1>
<p class="sub">What happened in the business, and why the system believes it. An <strong>event</strong> is something that happened (a product was picked up); an <strong>observation</strong> is only what a camera or sensor saw. <a href="settings/ai">Back to the AI helpers</a></p>
<Notice Error="@Error" Info="@Info" />

@if (!App.Ai.Flags.Licensed)
{
    <div class="notice warn" id="ev-unlicensed">The business event history is not part of this shop's licence. What was kept before stays readable, and nothing new is recorded.</div>
}
else if (!App.Events.Recording)
{
    <div class="notice warn" id="ev-off">The business event history is switched off, so nothing is being recorded. You can switch it on under <a href="settings/ai">AI helpers</a>. What is already here stays until its time is up.</div>
}

<section class="card" id="ev-counts">
    <h2>What is kept</h2>
    <div class="grid">
        <div class="card stat"><span class="label">Events</span><span class="value" id="ev-total">@(counts.Proposed + counts.Confirmed + counts.Rejected + counts.Superseded)</span><span class="note">@counts.Confirmed confirmed, @counts.Proposed waiting to be checked</span></div>
        <div class="card stat"><span class="label">Observations</span><span class="value" id="ev-obs">@counts.Observations</span><span class="note">seen by cameras and sensors</span></div>
        <div class="card stat"><span class="label">Wrong or replaced</span><span class="value">@(counts.Rejected + counts.Superseded)</span><span class="note">@counts.Rejected rejected, @counts.Superseded replaced</span></div>
    </div>
    @if (counts.OldestEvent is { } oldest && counts.NewestEvent is { } newest)
    {
        <p class="muted small">From @Day(oldest) to @Day(newest).</p>
    }
</section>

<section class="card" id="ev-queue">
    <h2>Waiting to be written down</h2>
    <p class="muted small">Every sale, return, payment, purchase and stock change leaves a short message when it happens. The program writes the messages into the history a moment later, so the till never waits for it. If the program stops in between, the messages are still here and are written when it starts again.</p>
    @if (queue.Paused)
    {
        <div class="notice warn" id="ev-queue-paused">@queue.Waiting message(s) are waiting because the business event history is switched off. They are written when it is switched on again.</div>
    }
    <div class="grid">
        <div class="card stat"><span class="label">Waiting</span><span class="value" id="ev-q-waiting">@queue.Waiting</span><span class="note">@(queue.OldestWaitingAge is { } age ? "the oldest for " + Wait(age) : "nothing is waiting")</span></div>
        <div class="card stat"><span class="label">Written down</span><span class="value" id="ev-q-done">@queue.Delivered</span></div>
        <div class="card stat"><span class="label">Could not be written</span><span class="value" id="ev-q-failed">@queue.Failed</span><span class="note">@(queue.Failed > 0 ? "tried several times; nothing was lost" : "none")</span></div>
    </div>
    @if (queue.Waiting > 0 && !queue.Paused)
    {
        <div class="row"><button type="button" class="btn secondary" id="ev-q-run" @onclick="WriteNow">Write the waiting ones down now</button></div>
    }
    @if (queue.Failed > 0)
    {
        <div class="row"><button type="button" class="btn secondary" id="ev-q-retry" @onclick="RetryFailed">Try the failed ones again</button></div>
        @foreach (var bad in failedMessages)
        {
            <p class="muted small">@bad.EventType (number @bad.Id): @bad.LastError</p>
        }
    }
</section>

<section class="card" id="ev-list">
    <h2>Look through the history</h2>
    <div class="field-row">
        <div>
            <label for="f-what">Show</label>
            <select id="f-what" @bind="filter.What"><option value="events">Events</option><option value="observations">What cameras and sensors saw</option></select>
        </div>
        <div><label for="f-type">Starts with</label><input id="f-type" @bind="filter.Words" maxlength="80" placeholder="for example customer_session" /></div>
        <div>
            <label for="f-status">Standing</label>
            <select id="f-status" @bind="filter.Status">
                <option value="">Any</option>
                @foreach (var s in EventStatus.All) { <option value="@s">@EventStatus.Label(s)</option> }
            </select>
        </div>
        <div><label for="f-from">From</label><input id="f-from" type="date" value="@filter.From" @onchange="e => filter.From = e.Value?.ToString() ?? string.Empty" /></div>
        <div><label for="f-to">To</label><input id="f-to" type="date" value="@filter.To" @onchange="e => filter.To = e.Value?.ToString() ?? string.Empty" /></div>
    </div>
    <div class="row"><button type="button" class="btn primary" id="f-go" @onclick="Search">Show</button></div>

    @if (filter.What == "events")
    {
        @if (events.Count == 0) { <div class="empty" id="ev-none">No events match.</div> }
        else
        {
            <div class="tbl-wrap">
            <table class="tbl" id="ev-table">
                <thead><tr><th>When</th><th>What</th><th>Who or what, where</th><th class="num">Sure</th><th>Standing</th><th></th></tr></thead>
                <tbody>
                @foreach (var e in events)
                {
                    var id = e.Id;
                    <tr id="@("ev-" + id)">
                        <td class="nowrap">@When(e.OccurredAt)</td>
                        <td>@EventTypes.Label(e.Type)</td>
                        <td>@Refs(e)</td>
                        <td class="num">@Percent(e.Confidence)</td>
                        <td>@EventStatus.Label(e.Status)</td>
                        <td class="row">
                            <button type="button" class="btn ghost small" @onclick="() => Explain(id)">Why?</button>
                            @if (e.Status == EventStatus.Proposed)
                            {
                                <button type="button" class="btn ghost small" @onclick="() => Decide(id, EventStatus.Confirmed)">Yes, it happened</button>
                                <button type="button" class="btn ghost small" @onclick="() => Decide(id, EventStatus.Rejected)">No, it was wrong</button>
                            }
                            else if (e.Status == EventStatus.Confirmed)
                            {
                                <button type="button" class="btn ghost small" @onclick="() => Decide(id, EventStatus.Rejected)">Mark as wrong</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
            @if (events.Count == Page) { <div class="row"><button type="button" class="btn ghost small" @onclick="More">Older ones</button></div> }
        }
    }
    else
    {
        @if (seen.Count == 0) { <div class="empty" id="ev-none">Nothing matches.</div> }
        else
        {
            <div class="tbl-wrap">
            <table class="tbl" id="obs-table">
                <thead><tr><th>When</th><th>Kind</th><th>Seen by</th><th>Where</th><th class="num">Sure</th><th>Kept until</th></tr></thead>
                <tbody>
                @foreach (var o in seen)
                {
                    <tr>
                        <td class="nowrap">@When(o.OccurredAt)</td>
                        <td>@EventTypes.Label(o.Kind)@(o.Label is null ? "" : " (" + o.Label + ")")</td>
                        <td>@SourceType.Label(o.SourceType) @o.SourceId@(o.ModelId is null ? "" : " · " + o.ModelId + (o.ModelVersion is null ? "" : " " + o.ModelVersion))</td>
                        <td>@(o.ZoneRef ?? "")</td>
                        <td class="num">@Percent(o.Confidence)</td>
                        <td class="nowrap">@Day(o.RetainUntil)</td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
            @if (seen.Count == Page) { <div class="row"><button type="button" class="btn ghost small" @onclick="More">Older ones</button></div> }
        }
    }
</section>

@if (why is not null)
{
    <section class="card" id="ev-why">
        <div class="head"><h2>Why does the system believe this?</h2><button type="button" class="btn ghost small" @onclick="() => why = null">Close</button></div>
        <p><strong>@EventTypes.Label(why.Event.Type)</strong>, @When(why.Event.OccurredAt). @EventStatus.Label(why.Event.Status).</p>
        <p id="ev-sentence">@why.Sentence</p>
        @if (why.Observations.Count > 0)
        {
            <h3>What it rests on</h3>
            <ul class="small">@foreach (var o in why.Observations) { <li>@When(o.OccurredAt): @EventTypes.Label(o.Kind) seen by @SourceType.Label(o.SourceType).ToLowerInvariant() @o.SourceId, @Percent(o.Confidence) sure</li> }</ul>
        }
        @if (why.Evidence.Count > 0)
        {
            <h3>Evidence</h3>
            <ul class="small">@foreach (var x in why.Evidence) { <li>@EvidenceKind.Label(x.Kind): <code>@x.Reference</code>, kept until @Day(x.RetainUntil)</li> }</ul>
        }
        @if (why.Replaces is not null) { <p class="small">It corrects an earlier event: @EventTypes.Label(why.Replaces.Type), @When(why.Replaces.OccurredAt).</p> }
        @if (why.ReplacedBy is not null) { <p class="small">It was replaced by a later event: @EventTypes.Label(why.ReplacedBy.Type), @When(why.ReplacedBy.OccurredAt).</p> }
    </section>
}

<section class="card" id="ev-state">
    <h2>What is true now</h2>
    <p class="muted small">Pick one thing or one place and see what the history says about it: the newest event that was confirmed, how many there are of each kind, and how long it has been quiet. A thing is written as <code>item:12</code> or <code>track:cam1:17</code>, a place as <code>zone:entrance</code>. Leave the day empty for now, or choose a day to see how it stood at the end of that day. Events that are still waiting to be checked are counted apart and do not decide anything.</p>
    <div class="field-row">
        <div><label for="st-ref">Thing or place</label><input id="st-ref" @bind="stateRef" maxlength="140" placeholder="for example item:12 or zone:entrance" /></div>
        <div><label for="st-when">As it stood on</label><input id="st-when" type="date" value="@stateWhen" @onchange="e => stateWhen = e.Value?.ToString() ?? string.Empty" /></div>
    </div>
    <div class="row">
        <button type="button" class="btn primary" id="st-go" @onclick="AskState">Show what is true</button>
        <button type="button" class="btn ghost" id="st-active" @onclick="ShowActive">Show what was active in the last day</button>
    </div>
    @if (asked is not null)
    {
        <p id="st-sentence"><strong>@Named(asked.Ref)</strong>: @asked.Sentence</p>
        @if (asked.ByType.Count > 0)
        {
            <div class="tbl-wrap">
            <table class="tbl" id="st-table">
                <thead><tr><th>What happened</th><th class="num">How many</th><th>The newest</th></tr></thead>
                <tbody>
                @foreach (var t in asked.ByType)
                {
                    <tr><td>@EventTypes.Label(t.Type)</td><td class="num">@t.Count</td><td class="nowrap">@When(t.LastAt)</td></tr>
                }
                </tbody>
            </table>
            </div>
        }
        @if (asked.Latest is { } latestOne)
        {
            <div class="row"><button type="button" class="btn ghost small" id="st-why" @onclick="() => Explain(latestOne.Id)">Why does the system believe the newest one?</button></div>
        }
    }
    @if (active is not null)
    {
        @if (active.Count == 0) { <div class="empty" id="st-none">Nothing had a confirmed event in the last day.</div> }
        else
        {
            <div class="tbl-wrap">
            <table class="tbl" id="st-active-table">
                <thead><tr><th>Thing</th><th>Newest event</th><th>When</th><th class="num">Events</th><th></th></tr></thead>
                <tbody>
                @foreach (var a in active)
                {
                    var reference = a.Ref;
                    <tr>
                        <td>@Named(reference)</td><td>@EventTypes.Label(a.LastType)</td><td class="nowrap">@When(a.LastAt)</td><td class="num">@a.Events</td>
                        <td class="row"><button type="button" class="btn ghost small" @onclick="() => LookAt(reference)">Look</button></td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
        }
    }
</section>

<section class="card" id="ev-rules">
    <h2>Automatic rules</h2>
    <p class="muted small">A rule watches the history for you: <em>when this many confirmed events of one kind happen within this time, propose a new event</em>. A rule can <strong>only propose</strong>: what it proposes appears in the list above as "Waiting to be checked", and nothing happens until you say yes. A rule is made switched off; once you switch it on it looks only at events recorded from that moment. If you change a rule it is switched off again.</p>
    @if (!App.Ai.Flags.IsEnabled(FlagKey.AdvancedRules))
    {
        <div class="notice warn" id="rl-off">Automatic rules are switched off, so the rules below do nothing. You can switch them on under <a href="settings/ai">AI helpers</a> (Advanced automatic rules).</div>
    }
    @if (ruleList.Count == 0) { <div class="empty" id="rl-none">There are no rules yet.</div> }
    else
    {
        <div class="tbl-wrap">
        <table class="tbl" id="rl-table">
            <thead><tr><th>Rule</th><th>What it does</th><th>Now</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in ruleList)
            {
                var rule = r;
                <tr id="@("rl-" + rule.Id)">
                    <td>@rule.Name</td>
                    <td class="small">@rule.Sentence@(string.IsNullOrWhiteSpace(rule.Explanation) ? "" : " " + rule.Explanation)</td>
                    <td class="nowrap">@(rule.Enabled ? "On" : "Off")@(rule.CheckedUntil is { } lookedTo && rule.Enabled ? ", looked until " + When(lookedTo) : "")</td>
                    <td class="row">
                        <button type="button" class="btn ghost small" @onclick="() => SwitchRule(rule)">@(rule.Enabled ? "Switch off" : "Switch on")</button>
                        <button type="button" class="btn ghost small" @onclick="() => EditRule(rule)">Change</button>
                        <button type="button" class="btn ghost small" @onclick="() => RetireRule(rule)">Retire</button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }
    <h3>@(form.Id is null ? "Make a rule" : "Change the rule")</h3>
    <div class="field-row">
        <div><label for="rl-name">Name</label><input id="rl-name" @bind="form.Name" maxlength="80" placeholder="for example Back door forced" /></div>
        <div><label for="rl-prefix">Count events starting with</label><input id="rl-prefix" @bind="form.Prefix" maxlength="80" placeholder="for example door.opened" /></div>
        <div><label for="rl-min">Each at least this sure (%)</label><input id="rl-min" class="qty" inputmode="numeric" @bind="form.Min" maxlength="3" /></div>
    </div>
    <div class="field-row">
        <div><label for="rl-count">When there are this many</label><input id="rl-count" class="qty" inputmode="numeric" @bind="form.Count" maxlength="4" /></div>
        <div><label for="rl-window">within this many minutes</label><input id="rl-window" class="qty" inputmode="numeric" @bind="form.Window" maxlength="5" /></div>
        <div>
            <label for="rl-group">that happened</label>
            <select id="rl-group" @bind="form.Group">@foreach (var g in RuleGroup.Known) { <option value="@g">@RuleGroup.Label(g)</option> }</select>
        </div>
    </div>
    <div class="field-row">
        <div><label for="rl-then">Then propose an event of type</label><input id="rl-then" @bind="form.Then" maxlength="80" placeholder="for example alert.door_forced" /></div>
        <div><label for="rl-sure">and say it is this sure (%)</label><input id="rl-sure" class="qty" inputmode="numeric" @bind="form.Sure" maxlength="3" /></div>
        <div><label for="rl-why">Note for whoever checks it (optional)</label><input id="rl-why" @bind="form.Explanation" maxlength="300" /></div>
    </div>
    <div class="row">
        <button type="button" class="btn primary" id="rl-save" @onclick="SaveRule">@(form.Id is null ? "Save the rule" : "Save the change")</button>
        @if (form.Id is not null) { <button type="button" class="btn ghost" id="rl-cancel" @onclick="() => form = new RuleForm()">Cancel</button> }
        <button type="button" class="btn ghost" id="rl-run" @onclick="RunRules">Look at the events now</button>
    </div>
</section>

<section class="card" id="ev-retention">
    <h2>How long things are kept</h2>
    <p class="muted small">Records are forgotten when their time is up, even when the history is switched off. What is private is kept for a short time unless you choose otherwise. Biometric data (faces, fingerprints) is <strong>not kept at all</strong> unless you write a number of days here. Card and payment details are never kept.</p>
    <div class="tbl-wrap">
    <table class="tbl">
        <thead><tr><th>Kind of data</th>@foreach (var subject in RetentionSubject.All) { <th class="num">@RetentionSubject.Label(subject) (days)</th> }<th></th></tr></thead>
        <tbody>
        @foreach (var dataClass in DataClass.All.Where(c => c != DataClass.PaymentSensitive))
        {
            var cls = dataClass;
            <tr>
                <td>@DataClass.Label(cls)</td>
                @foreach (var subject in RetentionSubject.All)
                {
                    var sub = subject;
                    var rule = rules.Single(r => r.Subject == sub && r.DataClass == cls);
                    <td class="num"><input class="qty" inputmode="numeric" id="@("ret-" + sub + "-" + cls)" aria-label="@(RetentionSubject.Label(sub) + ", " + DataClass.Label(cls))" placeholder="@(RetentionService.DefaultDays(sub, cls) == 0 ? "not kept" : RetentionService.DefaultDays(sub, cls).ToString(CultureInfo.InvariantCulture))" @bind="days[(sub, cls)]" maxlength="4" /></td>
                }
                <td class="row"><button type="button" class="btn ghost small" @onclick="() => SaveDays(cls)">Save</button></td>
            </tr>
        }
        </tbody>
    </table>
    </div>
    <p class="muted small">An empty box means the usual time (shown in grey).</p>
    <div class="row"><button type="button" class="btn ghost" id="ev-forget" @onclick="Forget">Forget what is past its time now</button></div>
</section>

@code {
    private const int Page = 25;

    private sealed class Filter { public string What = "events", Words = "", Status = "", From = "", To = ""; }

    private readonly Filter filter = new();
    private EventCounts counts = new(0, 0, 0, 0, 0, null, null);
    private IReadOnlyList<EventRecord> events = Array.Empty<EventRecord>();
    private IReadOnlyList<ObservationRecord> seen = Array.Empty<ObservationRecord>();
    private IReadOnlyList<RetentionRule> rules = Array.Empty<RetentionRule>();
    private readonly Dictionary<(string Subject, string DataClass), string> days = new();
    private EventExplanation? why;
    private long? beforeId;

    private OutboxStats queue = new(0, 0, 0, null, null, false);
    private IReadOnlyList<OutboxMessage> failedMessages = Array.Empty<OutboxMessage>();

    private IReadOnlyList<EventRule> ruleList = Array.Empty<EventRule>();
    private RuleForm form = new();

    private sealed class RuleForm
    {
        public long? Id;
        public string Name = "", Prefix = "", Group = RuleGroup.Subject, Then = "", Explanation = "", Min = "60", Count = "3", Window = "10", Sure = "70";
    }

    private static int Whole(string text, string what)
    {
        if (!int.TryParse((text ?? "").Trim(), NumberStyles.None, CultureInfo.InvariantCulture, out var n)) throw new HubException("bad-number", "'" + text + "' is not a whole number (" + what + ").");
        return n;
    }

    private async Task SaveRule()
    {
        var wasNew = form.Id is null;
        await Run(() =>
        {
            var input = new RuleInput(form.Name, form.Prefix, Whole(form.Min, "how sure the events must be") / 100.0, Whole(form.Count, "how many events"), Whole(form.Window, "minutes"), form.Group, form.Then,
                Whole(form.Sure, "how sure the proposal is") / 100.0, form.Explanation);
            if (form.Id is { } id) App.Rules.Update(id, input, Me.Id); else App.Rules.Create(input, Me.Id);
            form = new RuleForm();
        }, wasNew ? "Saved. The rule is switched off: switch it on when you are ready." : "Saved. The rule is switched off again: switch it on when you are ready.");
        await Reload();
    }

    private void EditRule(EventRule rule) => form = new RuleForm
    {
        Id = rule.Id, Name = rule.Name, Prefix = rule.TypePrefix, Group = rule.GroupBy, Then = rule.ThenType, Explanation = rule.Explanation ?? "",
        Min = Math.Round(rule.MinConfidence * 100).ToString(CultureInfo.InvariantCulture), Count = rule.Count.ToString(CultureInfo.InvariantCulture),
        Window = rule.WindowMinutes.ToString(CultureInfo.InvariantCulture), Sure = Math.Round(rule.ThenConfidence * 100).ToString(CultureInfo.InvariantCulture),
    };

    private async Task SwitchRule(EventRule rule)
    {
        await Run(() => App.Rules.SetEnabled(rule.Id, !rule.Enabled, Me.Id), rule.Enabled ? "Switched off." : "Switched on. It looks at events recorded from now on.");
        await Reload();
    }

    private async Task RetireRule(EventRule rule)
    {
        await Run(() => App.Rules.Retire(rule.Id, Me.Id), "Retired. What it proposed stays in the history.");
        await Reload();
    }

    private async Task RunRules()
    {
        await Run(() =>
        {
            if (!App.Rules.Running) { Info = "Rules are not running: the AI features need the licence, and \"Business event history\" and \"Advanced automatic rules\" must be switched on under AI helpers."; return; }
            var done = App.Rules.Run();
            Info = done.Rules == 0 ? "No rule is switched on." : "Looked at " + done.Looked + " event(s) for " + done.Rules + " rule(s): " + done.Proposed + " proposed" + (done.Skipped > 0 ? ", " + done.Skipped + " could not be kept" : "") + ".";
        });
        await Reload();
    }

    private string stateRef = "", stateWhen = "";
    private EntityState? asked;
    private IReadOnlyList<ActiveThing>? active;

    private async Task AskState()
    {
        await Run(() =>
        {
            var text = stateRef.Trim();
            var at = Date(stateWhen, end: true);
            asked = text.StartsWith("zone:", StringComparison.Ordinal) ? App.State.OfZone(text, at) : App.State.Of(text, at);
        });
    }

    private async Task ShowActive() => await Run(() => active = App.State.Active(null, TimeSpan.FromDays(1), 20));

    private async Task LookAt(string reference)
    {
        stateRef = reference;
        stateWhen = "";
        await AskState();
    }

    private static string Wait(TimeSpan age) => age.TotalMinutes < 1 ? "less than a minute" : age.TotalHours < 1 ? (int)age.TotalMinutes + " minute(s)" : age.TotalDays < 1 ? (int)age.TotalHours + " hour(s)" : (int)age.TotalDays + " day(s)";

    private async Task RetryFailed()
    {
        await Run(() =>
        {
            var again = App.Outbox.RetryFailed(Me.Id);
            var written = App.Outbox.Dispatch();
            Info = again == 0 ? "Nothing had failed." : again + " message(s) put back to be tried again; " + written + " written down now.";
        });
        await Reload();
    }

    private async Task WriteNow()
    {
        await Run(() => Info = App.Outbox.Dispatch() + " message(s) written down.");
        await Reload();
    }

    protected override Task LoadAsync()
    {
        queue = App.Outbox.Stats();
        failedMessages = queue.Failed > 0 ? App.Outbox.List("failed", 5) : Array.Empty<OutboxMessage>();
        counts = App.Events.Counts();
        ruleList = App.Rules.List();
        rules = App.Retention.Rules();
        foreach (var rule in rules) days[(rule.Subject, rule.DataClass)] = rule.IsDefault ? "" : rule.Days.ToString(CultureInfo.InvariantCulture);
        Query(reset: false);
        return Task.CompletedTask;
    }

    private void Query(bool reset)
    {
        if (reset) beforeId = null;
        var from = Date(filter.From, end: false);
        var to = Date(filter.To, end: true);
        if (filter.What == "events")
        {
            var found = App.Events.Query(new EventQuery(from, to, string.IsNullOrWhiteSpace(filter.Words) ? null : filter.Words.Trim(), string.IsNullOrEmpty(filter.Status) ? null : filter.Status, Limit: Page, BeforeId: beforeId));
            events = beforeId is null ? found : events.Concat(found).ToList();
        }
        else
        {
            var found = App.Events.QueryObservations(new ObservationQuery(from, to, string.IsNullOrWhiteSpace(filter.Words) ? null : filter.Words.Trim(), Limit: Page, BeforeId: beforeId));
            seen = beforeId is null ? found : seen.Concat(found).ToList();
        }
    }

    private DateTimeOffset? Date(string text, bool end)
    {
        if (!DateOnly.TryParseExact(text, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)) return null;
        return end ? Shop.Time.StartOfNextDay(date).AddSeconds(-1) : Shop.Time.StartOfDay(date);
    }

    private async Task Search() { why = null; await Run(() => Query(reset: true)); }

    private async Task More()
    {
        beforeId = filter.What == "events" ? events.LastOrDefault()?.Id : seen.LastOrDefault()?.Id;
        await Run(() => Query(reset: false));
    }

    private async Task Explain(long id) => await Run(() => why = App.Events.Explain(id));

    private async Task Decide(long id, string status)
    {
        await Run(() => App.Events.SetStatus(id, status, Me.Id), status == EventStatus.Confirmed ? "Confirmed." : "Marked as wrong. It stays in the history, and says so.");
        why = null;
        counts = App.Events.Counts();
        Query(reset: true);
    }

    private async Task SaveDays(string dataClass)
    {
        await Run(() =>
        {
            foreach (var subject in RetentionSubject.All)
            {
                var text = (days[(subject, dataClass)] ?? "").Trim();
                if (text.Length == 0) { App.Retention.UseDefault(subject, dataClass, Me.Id); continue; }
                if (!int.TryParse(text, NumberStyles.None, CultureInfo.InvariantCulture, out var n)) throw new HubException("bad-days", "'" + text + "' is not a number of days.");
                App.Retention.Set(subject, dataClass, n, Me.Id);
            }
        }, "Saved.");
        await Reload();
    }

    private async Task Forget()
    {
        await Run(() =>
        {
            var result = App.Retention.Prune(Me.Id);
            Info = result.Any
                ? "Forgot " + result.Events + " events, " + result.Observations + " observations and " + result.Evidence + " pointers to evidence."
                : "Nothing is past its time.";
        });
        await Reload();
    }

    private readonly Dictionary<string, string> named = new();

    /// <summary>The things an event points at, by name where the business map knows them ("Basmati rice (product:12)") and by reference where it does not.</summary>
    private string Refs(EventRecord e) => string.Join(" · ", new[] { e.ActorRef ?? e.SubjectRef, e.ObjectRef, e.ZoneRef }.Where(x => !string.IsNullOrEmpty(x)).Select(x => Named(x!)));

    private string Named(string reference)
    {
        if (named.TryGetValue(reference, out var known)) return known;
        string text = reference;
        try
        {
            if (Ontology.ThingRef.TryParse(reference, out var thing) && AsMe(() => App.Ontology.Resolve(thing)) is { Exists: true } view && !view.Retired) text = view.Label + " (" + reference + ")";
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { /* a name that cannot be looked up is shown as the reference */ }
        return named[reference] = text;
    }

    private static string Percent(double confidence) => Math.Round(confidence * 100).ToString(CultureInfo.InvariantCulture) + "%";
}

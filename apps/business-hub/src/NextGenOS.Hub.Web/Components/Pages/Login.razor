@page "/login"
@layout PublicLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authentication
@inject HubApp App
@inject NavigationManager Nav

<PageTitle>Sign in</PageTitle>
<h1 class="public-title">Sign in</h1>
<p class="muted">@App.Shop.Current.Settings.Name</p>

@if (!string.IsNullOrEmpty(error))
{
    <div class="notice error" role="alert">@error</div>
}

<form method="post" @formname="login" @onsubmit="SignIn" class="stack">
    <AntiforgeryToken />
    <label for="username">User name</label>
    <input id="username" name="Username" @bind="Username" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus required />
    <label for="password">Password</label>
    <input id="password" name="Password" type="password" @bind="Password" autocomplete="current-password" required />
    <button type="submit" class="btn primary wide">Sign in</button>
</form>

@code {
    [CascadingParameter] private HttpContext Http { get; set; } = default!;
    [SupplyParameterFromForm(Name = "Username")] private string? Username { get; set; }
    [SupplyParameterFromForm(Name = "Password")] private string? Password { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] private string? ReturnUrl { get; set; }

    private string? error;

    private async Task SignIn()
    {
        try
        {
            var user = App.Users.Authenticate(Username ?? "", Password ?? "");
            await Http.SignInAsync(Session.Principal(user), new AuthenticationProperties { IsPersistent = false });
            App.Audit.Log(user.Id, "sign-in", "user", user.Id);
            Nav.NavigateTo(Local(ReturnUrl), forceLoad: true);
        }
        catch (HubException ex)
        {
            error = ex.Message;
            Password = null;
        }
    }

    /// <summary>Only a page of this program: never an address that sends the person to another site.</summary>
    internal static string Local(string? url) =>
        !string.IsNullOrEmpty(url) && url.StartsWith('/') && !url.StartsWith("//", StringComparison.Ordinal) && !url.StartsWith("/\\", StringComparison.Ordinal) && !url.Contains('\n') && !url.Contains('\r') ? url : "/";
}

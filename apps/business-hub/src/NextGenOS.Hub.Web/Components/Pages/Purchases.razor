@page "/purchases"
@attribute [Authorize(Policy = Perm.Purchases)]
@inherits HubPage
@using NextGenOS.Hub.Purchasing
@using NextGenOS.Hub.Insights

<PageTitle>Buying</PageTitle>
<h1>Buying</h1>
<p class="sub">Orders to suppliers: when the goods arrive, stock goes up and the cost is updated.</p>
<Notice Error="@Error" Info="@Info" />

<div class="toolbar">
    <div class="seg" role="group" aria-label="Show">
        @foreach (var (key, label) in new[] { ("open", "To receive"), ("owed", "To pay"), ("all", "All") })
        {
            <button type="button" class="@(tab == key ? "on" : "")" aria-pressed="@(tab == key)" @onclick="() => OpenTab(key)">@label</button>
        }
    </div>
    <span class="spacer"></span>
    <button type="button" class="btn primary" id="new-order" @onclick="NewOrder">New order</button>
</div>

@if (actionsOn && waiting.Count > 0)
{
    <section class="card" id="approvals">
        <h2>Waiting for approval</h2>
        <p class="muted small">Things that have been asked for and are not done until a person who may buy says yes. Nothing is bought or paid by approving: it makes a draft order that you receive and pay for as usual.</p>
        @foreach (var a in waiting)
        {
            <div class="approval-row" id="approval-@a.Id">
                <p>@a.Summary</p>
                <p class="muted small">Asked for by @(a.ProposedByName ?? "the program") on @When(a.ProposedAt). It runs out on @When(a.ExpiresAt).</p>
                <div class="row">
                    <button type="button" class="btn primary small" id="approve-@a.Id" @onclick="() => ApproveAction(a)">Approve and draft the order</button>
                    <button type="button" class="btn ghost small" id="decline-@a.Id" @onclick="() => DeclineAction(a)">Decline</button>
                </div>
            </div>
        }
    </section>
}

@if (insightsOn)
{
    <section class="card" id="low-stock">
        <h2>Running low</h2>
        <p class="muted small">Goods that will run out before a new delivery could arrive, at the pace they have been selling lately. These are suggestions, not orders: read the reasons and decide.</p>
        @if (lowRun is null)
        {
            <p class="muted" id="low-never">Not checked yet.</p>
        }
        else
        {
            <p class="muted small" id="low-summary">Checked @When(lowRun.Run.CreatedAt): @lowRun.Judged item(s) judged@(lowRun.NoTerms > 0 ? ", " + lowRun.NoTerms + " with no delivery time yet" : "")@(lowRun.ShortHistory > 0 ? ", " + lowRun.ShortHistory + " too new to tell" : "")@(lowRun.NoSales > 0 ? ", " + lowRun.NoSales + " not selling" : "").</p>
        }
        <div class="row">
            <button type="button" class="btn secondary" id="low-check" @onclick="CheckNow">Check now</button>
            <button type="button" class="btn secondary" id="terms-open" @onclick="OpenTerms">Delivery times</button>
        </div>
        @if (lowRun is not null && findings.Count == 0) { <div class="empty" id="low-none">Nothing is running low.</div> }
        @foreach (var f in findings)
        {
            <div class="low-row" id="low-@f.Id" data-item="@f.ItemId">
                <p><strong>@f.Detail.Name</strong> <span class="muted">@(f.Status == "covered" ? "— already on order" : "")</span></p>
                <p class="low-explain">@f.Detail.Explanation</p>
                <details><summary>Why might this be wrong?</summary><p class="muted small">@f.Detail.WhyWrong</p>
                    <p class="muted small">Worked out on @Day(f.Detail.AsOf) from @(f.Detail.SaleDocuments.Count == 0 ? "the stock records" : "bills " + string.Join(", ", f.Detail.SaleDocuments.Take(5)) + (f.Detail.SaleDocuments.Count > 5 ? " and others" : "")).</p></details>
                <div class="row">
                    @if (f.Status == "order") { <button type="button" class="btn primary small" id="low-order-@f.Id" @onclick="() => StartOrder(f)">Start an order for @Qty(f.Detail.ProposedMilli) @f.Detail.Unit</button> }
                    @if (f.Status == "order" && actionsOn) { <button type="button" class="btn secondary small" id="low-ask-@f.Id" @onclick="() => AskFor(f)">Ask for approval</button> }
                    <button type="button" class="btn ghost small" id="low-dismiss-@f.Id" @onclick="() => SetAside(f)">Set aside</button>
                </div>
            </div>
        }
    </section>
}

<div class="card tbl-wrap">
    @if (rows.Count == 0) { <div class="empty">Nothing here.</div> }
    else
    {
        <table class="tbl">
            <thead><tr><th>Order</th><th>Supplier</th><th>Date</th><th class="num">Total</th><th class="num">To pay</th><th></th></tr></thead>
            <tbody>
            @foreach (var d in rows)
            {
                <tr>
                    <td><a href="documents/@d.Id">@d.Number</a></td>
                    <td>@(d.PartyId is { } pid ? Name(pid) : "")</td>
                    <td>@Day(d.IssuedAt ?? d.CreatedAt)</td>
                    <td class="num">@Money(d.TotalMinor)</td>
                    <td class="num">@(d.BalanceMinor > 0 ? Money(d.BalanceMinor) : "")</td>
                    <td class="right nowrap">
                        @if (d.Status == DocStatus.Open) { <button type="button" class="btn secondary small" @onclick="() => Receive(d)">Goods arrived</button> }
                        @if (d.BalanceMinor > 0) { <button type="button" class="btn ghost small" @onclick="() => OpenPay(d)">Pay</button> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

@if (ordering)
{
    <div class="sheet-back" @onclick="() => ordering = false">
        <div class="sheet" role="dialog" aria-modal="true" aria-label="New order" @onclick:stopPropagation="true">
            <h2>New order</h2>
            <Notice Error="@formError" />
            <label for="po-supplier">Supplier</label>
            <select id="po-supplier" @bind="supplierId"><option value="">Choose…</option>@foreach (var s in suppliers) { <option value="@s.Id">@s.Name</option> }</select>
            @if (suppliers.Count == 0) { <p class="muted small">Add a supplier under People first.</p> }
            <label for="po-item">What</label>
            <div class="inline-form">
                <div><select id="po-item" @bind="itemId" @bind:after="PickItem"><option value="">Choose…</option>@foreach (var i in items) { <option value="@i.Id">@i.Name</option> }</select></div>
                <div><input class="qty" aria-label="How many" inputmode="decimal" placeholder="How many" @bind="qty" /></div>
                <div><input class="qty" aria-label="Cost of each" inputmode="decimal" placeholder="Cost each" @bind="cost" /></div>
                <button type="button" class="btn secondary" id="add-order-line" @onclick="AddLine">Add</button>
            </div>
            @foreach (var (l, n) in lines.Select((l, n) => (l, n)))
            {
                <div class="total-row"><span>@Qty(l.QtyMilli) × @(items.FirstOrDefault(i => i.Id == l.ItemId)?.Name)</span><span>@Money(l.CostMinor * l.QtyMilli / 1000) <button type="button" class="btn ghost small" aria-label="Take off this line" @onclick="() => lines.RemoveAt(n)">×</button></span></div>
            }
            <div class="row"><button type="button" class="btn secondary" @onclick="() => ordering = false">Cancel</button><button type="button" class="btn primary grow" id="save-order" @onclick="SaveOrder">Place the order</button></div>
        </div>
    </div>
}

@if (termsSheet)
{
    <div class="sheet-back" @onclick="() => termsSheet = false">
        <div class="sheet" role="dialog" aria-modal="true" aria-label="Delivery times" @onclick:stopPropagation="true">
            <h2>Delivery times</h2>
            <p class="muted small">For each thing you keep in stock: who supplies it, how many days they take to deliver, and how many spare days you want. Running low is judged only for goods that have these.</p>
            <Notice Error="@formError" />
            <label for="terms-item">What</label>
            <select id="terms-item" @bind="termItem" @bind:after="PickTermItem"><option value="">Choose…</option>@foreach (var i in stocked) { <option value="@i.Id">@i.Name@(termsByItem.ContainsKey(i.Id) ? " ✓" : "")</option> }</select>
            <label for="terms-supplier">Supplier</label>
            <select id="terms-supplier" @bind="termSupplier"><option value="">Choose…</option>@foreach (var s in suppliers) { <option value="@s.Id">@s.Name</option> }</select>
            @if (suppliers.Count == 0) { <p class="muted small">Add a supplier under People first.</p> }
            <div class="inline-form">
                <div><label for="terms-lead">Days to deliver</label><input id="terms-lead" class="qty" inputmode="numeric" @bind="termLead" /></div>
                <div><label for="terms-safety">Spare days</label><input id="terms-safety" class="qty" inputmode="numeric" @bind="termSafety" /></div>
            </div>
            <div class="inline-form">
                <div><label for="terms-pack">Comes in packs of</label><input id="terms-pack" class="qty" inputmode="decimal" @bind="termPack" /></div>
                <div><label for="terms-min">Least they send</label><input id="terms-min" class="qty" inputmode="decimal" @bind="termMin" /></div>
            </div>
            <div class="row">
                <button type="button" class="btn primary grow" id="terms-save" @onclick="SaveTerms">Save</button>
                @if (termItem != "" && termsByItem.ContainsKey(long.Parse(termItem))) { <button type="button" class="btn ghost" id="terms-clear" @onclick="ClearTerms">Take away</button> }
            </div>
            @if (termsByItem.Count > 0)
            {
                <table class="tbl" id="terms-table"><thead><tr><th>Item</th><th>Supplier</th><th class="num">Days</th><th class="num">Spare</th></tr></thead><tbody>
                @foreach (var t in termsByItem.Values.OrderBy(x => x.ItemId))
                {
                    <tr><td>@(stocked.FirstOrDefault(i => i.Id == t.ItemId)?.Name)</td><td>@(suppliers.FirstOrDefault(x => x.Id == t.SupplierId)?.Name)</td><td class="num">@t.LeadDays</td><td class="num">@t.SafetyDays</td></tr>
                }
                </tbody></table>
            }
            @if (Me.Can(Perm.Settings))
            {
                <h3>How it decides</h3>
                <div class="inline-form">
                    <div><label for="set-window">Days of selling to look at</label><input id="set-window" class="qty" inputmode="numeric" @bind="setWindow" /></div>
                    <div><label for="set-review">Days an order should cover beyond delivery</label><input id="set-review" class="qty" inputmode="numeric" @bind="setReview" /></div>
                    <div><label for="set-snooze">Days to stay quiet after “Set aside”</label><input id="set-snooze" class="qty" inputmode="numeric" @bind="setSnooze" /></div>
                </div>
                <div class="row"><button type="button" class="btn secondary" id="set-save" @onclick="SaveSettings">Save these</button></div>
            }
            <div class="row"><button type="button" class="btn secondary" @onclick="() => termsSheet = false">Close</button></div>
        </div>
    </div>
}

@if (paying is not null)
{
    <div class="sheet-back" @onclick="() => paying = null">
        <div class="sheet" role="dialog" aria-modal="true" aria-label="Pay the supplier" @onclick:stopPropagation="true">
            <h2>Pay for @paying.Number</h2>
            <p>Owed: <strong>@Money(paying.BalanceMinor)</strong></p>
            <Notice Error="@formError" />
            <label for="pp-amt">Amount</label><input id="pp-amt" inputmode="decimal" placeholder="@Shop.Text(paying.BalanceMinor)" @bind="payAmount" />
            <label for="pp-method">Paid by</label><select id="pp-method" @bind="payMethod">@foreach (var m in Shop.PaymentMethods) { <option value="@m">@m</option> }</select>
            <label for="pp-ref">Reference</label><input id="pp-ref" @bind="payRef" maxlength="60" />
            <div class="row"><button type="button" class="btn secondary" @onclick="() => paying = null">Cancel</button><button type="button" class="btn primary grow" id="save-supplier-payment" @onclick="Pay">Save the payment</button></div>
        </div>
    </div>
}

@code {
    private string tab = "open";
    private IReadOnlyList<NextGenOS.Hub.Documents.Document> rows = Array.Empty<NextGenOS.Hub.Documents.Document>();
    private IReadOnlyList<Party> suppliers = Array.Empty<Party>();
    private IReadOnlyList<Item> items = Array.Empty<Item>();
    private readonly Dictionary<long, string> names = new();
    private bool ordering;
    private string supplierId = "", itemId = "", qty = "1", cost = "", formError = "", payAmount = "", payMethod = "bank", payRef = "";
    private readonly List<PurchaseLine> lines = new();
    private NextGenOS.Hub.Documents.Document? paying;

    protected override Task LoadAsync()
    {
        Read();
        ReadInsights();
        return Task.CompletedTask;
    }

    // ---- running low (stock forecasts) ----------------------------------------------------------------------------------------------------
    private bool insightsOn, actionsOn, termsSheet;
    private IReadOnlyList<NextGenOS.Hub.Actions.ActionView> waiting = Array.Empty<NextGenOS.Hub.Actions.ActionView>();
    private RunSummary? lowRun;
    private IReadOnlyList<StoredFinding> findings = Array.Empty<StoredFinding>();
    private IReadOnlyList<Item> stocked = Array.Empty<Item>();
    private Dictionary<long, SupplyTerms> termsByItem = new();
    private string termItem = "", termSupplier = "", termLead = "5", termSafety = "2", termPack = "1", termMin = "0";
    private string setWindow = "28", setReview = "7", setSnooze = "7";

    private void ReadInsights()
    {
        actionsOn = App.Actions.On;
        waiting = actionsOn ? App.Actions.List([NextGenOS.Hub.Actions.ActionStatus.AwaitingApproval]) : [];
        insightsOn = App.Insights.On;
        if (!insightsOn) return;
        lowRun = App.Insights.Latest();
        findings = App.Insights.Open();
    }

    /// <summary>Asks for the order a warning proposes, to be approved by someone who may buy. Asking twice for the same warning is the same request.</summary>
    private Task AskFor(StoredFinding f) => Run(() =>
    {
        var cost = App.Catalog.Get(f.ItemId)?.CostMinor ?? 0;
        var input = System.Text.Json.JsonSerializer.Serialize(new NextGenOS.Hub.Actions.CreatePurchaseOrderInput(f.Detail.SupplierId, [new NextGenOS.Hub.Actions.OrderLineInput(f.ItemId, f.Detail.ProposedMilli, cost)]));
        App.Actions.Propose("CreatePurchaseOrder", 1, input, "finding", f.Id, "finding:" + f.Id, Me.Id);
        ReadInsights();
    }, "Asked for. It waits for approval above.");

    private Task ApproveAction(NextGenOS.Hub.Actions.ActionView a) => Run(() =>
    {
        App.Actions.Approve(a.Id, null, Me.Id);
        Read();
        ReadInsights();
    }, "Approved. The order is drafted: you will find it under “To receive”.");

    private Task DeclineAction(NextGenOS.Hub.Actions.ActionView a) => Run(() =>
    {
        App.Actions.Decline(a.Id, null, Me.Id);
        ReadInsights();
    }, "Declined. Nothing was done.");

    private Task CheckNow() => Run(() =>
    {
        App.Insights.Run(Me.Id);
        ReadInsights();
    }, "Checked.");

    private Task SetAside(StoredFinding f) => Run(() =>
    {
        App.Insights.Dismiss(f.Id, null, Me.Id);
        ReadInsights();
    }, "Set aside. It stays quiet for a few days, and the record is kept.");

    private void StartOrder(StoredFinding f)
    {
        NewOrder();
        supplierId = f.Detail.SupplierId.ToString();
        itemId = f.ItemId.ToString();
        qty = Qty(f.Detail.ProposedMilli);
        PickItem();
        AddLine();
    }

    private void OpenTerms()
    {
        stocked = App.Catalog.Search(null, null, null, 500).Where(i => i.TrackStock && i.Kind is not ("service" or "title")).ToList();
        suppliers = App.Parties.Search("supplier", null, 300);
        termsByItem = App.Supply.All().ToDictionary(t => t.ItemId);
        var settings = App.Insights.Settings();
        (setWindow, setReview, setSnooze) = (settings.WindowDays.ToString(), settings.ReviewDays.ToString(), settings.SnoozeDays.ToString());
        termItem = termSupplier = formError = "";
        (termLead, termSafety, termPack, termMin) = ("5", "2", "1", "0");
        termsSheet = true;
    }

    private void PickTermItem()
    {
        if (long.TryParse(termItem, out var id) && termsByItem.TryGetValue(id, out var t))
            (termSupplier, termLead, termSafety, termPack, termMin) = (t.SupplierId.ToString(), t.LeadDays.ToString(), t.SafetyDays.ToString(), Qty(t.PackMilli), Qty(t.MinOrderMilli));
    }

    private void SaveTerms()
    {
        formError = "";
        try
        {
            if (!long.TryParse(termItem, out var item)) throw new HubException("item", "Please choose what it is.");
            if (!long.TryParse(termSupplier, out var supplier)) throw new HubException("supplier", "Please choose the supplier.");
            if (!int.TryParse(termLead.Trim(), out var lead)) throw new HubException("lead", "Please type the days they take to deliver, like 5.");
            if (!int.TryParse(termSafety.Trim(), out var safety)) throw new HubException("safety", "Please type the spare days you want, like 2 (or 0).");
            long pack, min;
            try { pack = ShopContext.QtyMilli(termPack.Trim()); min = termMin.Trim().Length == 0 ? 0 : ShopContext.QtyMilli(termMin.Trim()); }
            catch (FormatException) { throw new HubException("qty", "Please type the pack size and the least they send as numbers, like 12 and 24."); }
            App.Supply.Set(item, supplier, lead, safety, pack, min, Me.Id);
            termsByItem = App.Supply.All().ToDictionary(t => t.ItemId);
            Info = "Saved. The next check will use it.";
        }
        catch (HubException ex) { formError = ex.Message; }
    }

    private void ClearTerms()
    {
        formError = "";
        try
        {
            if (long.TryParse(termItem, out var item)) App.Supply.Clear(item, Me.Id);
            termsByItem = App.Supply.All().ToDictionary(t => t.ItemId);
            termItem = "";
        }
        catch (HubException ex) { formError = ex.Message; }
    }

    private void SaveSettings()
    {
        formError = "";
        try
        {
            if (!int.TryParse(setWindow.Trim(), out var window) || !int.TryParse(setReview.Trim(), out var review) || !int.TryParse(setSnooze.Trim(), out var snooze))
                throw new HubException("number", "Please type whole numbers of days.");
            var current = App.Insights.Settings();
            App.Insights.SaveSettings(current with { WindowDays = window, ReviewDays = review, SnoozeDays = snooze }, Me.Id);
            Info = "Saved. The next check will use it.";
        }
        catch (HubException ex) { formError = ex.Message; }
    }



    private void OpenTab(string key)
    {
        tab = key;
        Read();
    }

    private void Read()
    {
        rows = tab switch
        {
            "open" => App.Documents.List(new DocumentFilter { Type = DocTypes.Purchase, Status = DocStatus.Open, Limit = 300 }),
            "owed" => App.Purchasing.Payable(),
            _ => App.Documents.List(new DocumentFilter { Type = DocTypes.Purchase, Limit = 300 }),
        };
    }

    private string Name(long id)
    {
        if (!names.TryGetValue(id, out var n)) names[id] = n = App.Parties.Get(id)?.Name ?? "";
        return n;
    }

    private void NewOrder()
    {
        suppliers = App.Parties.Search("supplier", null, 300);
        items = App.Catalog.Search(null, null, null, 500).Where(i => i.Kind is not ("service" or "title")).ToList();
        lines.Clear();
        supplierId = itemId = cost = formError = "";
        qty = "1";
        ordering = true;
    }

    private void PickItem()
    {
        if (long.TryParse(itemId, out var id) && items.FirstOrDefault(i => i.Id == id) is { } item && item.CostMinor > 0) cost = Shop.Text(item.CostMinor);
    }

    private void AddLine()
    {
        formError = "";
        try
        {
            if (!long.TryParse(itemId, out var id)) throw new HubException("item", "Please choose what you are buying.");
            long q;
            try { q = ShopContext.QtyMilli(qty.Trim()); } catch (FormatException) { throw new HubException("qty", "Please type how many, like 20."); }
            if (q <= 0) throw new HubException("qty", "Please type how many, like 20.");
            if (!TryMoney(Shop, cost, out var c) || c < 0) throw new HubException("cost", "Please type what one costs, like 120.50.");
            lines.Add(new PurchaseLine { ItemId = id, QtyMilli = q, CostMinor = c });
            itemId = cost = "";
            qty = "1";
        }
        catch (HubException ex) { formError = ex.Message; }
    }

    private void SaveOrder()
    {
        formError = "";
        try
        {
            if (!long.TryParse(supplierId, out var s)) throw new HubException("supplier", "Please choose the supplier.");
            App.Purchasing.CreateOrder(s, lines.ToList(), null, Me.Id);
            ordering = false;
            tab = "open";
            Read();
            Info = "The order is placed. When the goods arrive, press “Goods arrived”.";
        }
        catch (HubException ex) { formError = ex.Message; }
    }

    private Task Receive(NextGenOS.Hub.Documents.Document d) => Run(() =>
    {
        App.Purchasing.Receive(d.Id, Me.Id);
        Read();
    }, "Stock is updated.");

    private void OpenPay(NextGenOS.Hub.Documents.Document d)
    {
        paying = d;
        payAmount = payRef = formError = "";
        payMethod = Shop.PaymentMethods.Contains("bank") ? "bank" : Shop.PaymentMethods[0];
    }

    private void Pay()
    {
        formError = "";
        try
        {
            var amount = paying!.BalanceMinor;
            if (payAmount.Trim().Length > 0 && (!TryMoney(Shop, payAmount, out amount) || amount <= 0)) throw new HubException("amount", "Please type the amount as a number, like 5000.");
            App.Purchasing.Pay(paying.Id, amount, payMethod, string.IsNullOrWhiteSpace(payRef) ? null : payRef.Trim(), Me.Id);
            paying = null;
            Read();
            Info = "Payment saved.";
        }
        catch (HubException ex) { formError = ex.Message; }
    }
}

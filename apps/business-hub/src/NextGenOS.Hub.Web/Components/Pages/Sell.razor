@page "/sell"
@attribute [Authorize(Policy = Perm.Sell)]
@implements IDisposable
@inherits HubPage
@inject IJSRuntime Js

<PageTitle>@(Shop.Singular("sale") == "Order" ? "Take an order" : "New " + Shop.Singular("sale").ToLowerInvariant())</PageTitle>
<h1>@(Shop.Singular("sale") == "Order" ? "Take an order" : "New " + Shop.Singular("sale").ToLowerInvariant())</h1>
<p class="sub">Scan a barcode, or type a name and press Enter.@if (drawerPrinter) { <button type="button" class="btn ghost small" id="drawer" @onclick="OpenDrawer">Open the cash drawer</button> }</p>
@if (KeyHint() is { Length: > 0 } hint) { <p class="muted small" id="till-keys">Keys: @hint</p> }
<Notice Error="@Error" Info="@Info" />

<div class="pos">
    <div>
        <div class="card">
            <input id="scan" class="big-input-left" placeholder="Scan or search" autocomplete="off" @bind="query" @bind:event="oninput" @onkeydown="OnKey" aria-label="Scan or search" />
            <div class="row"><CameraScan Id="cam-sell" Label="Scan with the camera" OnScanned="ScanFromCamera" /></div>
            @if (groups.Count > 0)
            {
                <div class="chips" role="group" aria-label="Quick groups">
                    @foreach (var g in groups)
                    {
                        <button type="button" class="group-chip" id="group-@g.Id" @onclick="() => AddGroup(g)" title="@string.Join(", ", g.Members.Select(m => Qty(m.QtyMilli) + " × " + m.Name))">+ @g.Name</button>
                    }
                </div>
            }
            @if (categories.Count > 0)
            {
                <div class="chips" role="group" aria-label="Categories">
                    <button type="button" class="@(category is null ? "on" : "")" @onclick="() => PickCategory(null)">All</button>
                    @foreach (var c in categories)
                    {
                        <button type="button" class="@(category == c ? "on" : "")" @onclick="() => PickCategory(c)">@c</button>
                    }
                </div>
            }
            @if (results.Count == 0)
            {
                <div class="empty">Nothing found. Check the spelling, or add it under @Shop.Plural("item").</div>
            }
            else
            {
                <div class="items">
                    @foreach (var item in results)
                    {
                        <button type="button" class="item-btn" @onclick="() => Add(item)">
                            <span class="nm">@item.Name</span>
                            <span class="pr">@Money(item.PriceFor(customer?.PriceLevel ?? "retail"))@(item.Unit is "pc" ? "" : " / " + item.Unit)</span>
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    <div class="card cart">
        <h2>@Shop.Singular("sale")</h2>
        @if (cart is null || cart.Lines.Count == 0)
        {
            <div class="empty">Nothing added yet.</div>
        }
        else
        {
            @foreach (var line in cart.Lines)
            {
                var result = cart.ResultFor(line);
                if (line.IsFree)
                {
                    <div class="line free-goods" data-free="true">
                        <span class="nm">@line.Description</span>
                        <span class="amt">Free</span>
                        <div class="ctl"><span class="muted small">@Qty(line.QtyMilli) free with the one above</span></div>
                    </div>
                    continue;
                }
                <div class="line">
                    <span class="nm">@line.Description</span>
                    <span class="amt">@(result is null ? "" : Shop.Money(Shop.Minor(result.LineTotal)))</span>
                    <div class="ctl">
                        <button type="button" class="qbtn" aria-label="One less of @line.Description" @onclick="() => Change(line, -1000)">−</button>
                        <input class="qty" inputmode="decimal" aria-label="Quantity of @line.Description" value="@Qty(line.QtyMilli)" @onchange="e => SetQty(line, e.Value?.ToString())" />
                        <button type="button" class="qbtn" aria-label="One more of @line.Description" @onclick="() => Change(line, 1000)">+</button>
                        <span class="muted small">× @Money(line.UnitPriceMinor)</span>
                        <span class="spacer"></span>
                        <button type="button" class="btn ghost small" @onclick="() => Remove(line)">Remove</button>
                    </div>
                    @if (CanDiscount)
                    {
                        <div class="ctl">
                            <input class="disc-in" inputmode="decimal" aria-label="Discount on @line.Description" placeholder="Discount (10% or an amount)" value="@LineDiscountText(line)" @onchange="e => SetLineDiscount(line, e.Value?.ToString())" />
                        </div>
                    }
                </div>
            }

            @if (CanDiscount)
            {
                <div class="row discount-row">
                    <label for="bill-discount" class="grow">Discount on the whole bill</label>
                    <input id="bill-discount" class="disc-in" inputmode="decimal" placeholder="10% or an amount" value="@BillDiscountText()" @onchange="e => SetBillDiscount(e.Value?.ToString())" />
                </div>
            }
            var offers = App.Offers.ForDocument(cart.Document.Id);
            @if (offers.Applied.Count > 0 || offers.Declined is not null || App.Offers.AnyUnusedVouchers)
            {
                <div class="offers" id="offers">
                    @foreach (var applied in offers.Applied)
                    {
                        <div class="total-row muted offer-row" data-offer="@applied.Kind"><span>@applied.Label</span><span>−@Money(applied.AmountMinor) @if (applied.VoucherId is { } voucherId) { <button type="button" class="btn ghost small" aria-label="Take off @applied.Label" @onclick="() => TakeOffCode(voucherId)">×</button> } else { <button type="button" class="btn ghost small" aria-label="Leave out @applied.Label" @onclick="() => LeaveOutOffer(true)">Leave out</button> }</span></div>
                    }
                    @if (offers.Declined is { } skipped)
                    {
                        <div class="total-row muted offer-row"><span>@skipped.Label (@Money(skipped.AmountMinor)) is not used</span><span><button type="button" class="btn ghost small" id="use-offer" @onclick="() => LeaveOutOffer(false)">Use it</button></span></div>
                    }
                    <div class="row code-row">
                        <input id="voucher-code" class="disc-in" autocomplete="off" aria-label="Coupon or voucher code" placeholder="Coupon or voucher code" @bind="code" @bind:event="oninput" @onkeydown="OnCodeKey" />
                        <button type="button" class="btn secondary small" id="use-code" @onclick="UseCode">Use code</button>
                    </div>
                </div>
            }
            @if (cart.Result is { } given && Shop.Minor(given.Totals.Discount) > 0)
            {
                <div class="total-row muted"><span>Discount given</span><span id="discount-given">−@Shop.Money(Shop.Minor(given.Totals.Discount))</span></div>
            }
            <div class="total-row"><span>Subtotal</span><span>@Money(cart.Document.SubtotalMinor)</span></div>
            @foreach (var part in TaxParts())
            {
                <div class="total-row muted"><span>@part.Name</span><span>@Shop.Money(Shop.Minor(part.Amount))</span></div>
            }
            @if (cart.Result is { } r && Shop.Minor(r.Totals.RoundOff) != 0)
            {
                <div class="total-row muted"><span>Rounding</span><span>@Shop.Money(Shop.Minor(r.Totals.RoundOff))</span></div>
            }
            <div class="total-row big"><span>Total</span><span id="total">@Money(cart.Document.PayableMinor)</span></div>

            <h3>Customer</h3>
            @if (customer is not null)
            {
                <div class="row"><strong class="grow">@customer.Name</strong><button type="button" class="btn ghost small" @onclick="ClearCustomer">Change</button></div>
            }
            else
            {
                <input id="customer-search" placeholder="Search by name or phone (or leave empty)" aria-label="Customer" @bind="customerQuery" @bind:event="oninput" />
                @if (customerQuery.Trim().Length >= 2)
                {
                    <div class="chips">
                        @foreach (var p in App.Parties.Search("customer", customerQuery, 6))
                        {
                            <button type="button" @onclick="() => PickCustomer(p)">@p.Name</button>
                        }
                    </div>
                }
            }

            @if (salespeople.Count > 0)
            {
                <h3>Salesperson</h3>
                <select id="salesperson" aria-label="Salesperson" value="@(salespersonId?.ToString() ?? "")" @onchange="e => salespersonId = long.TryParse(e.Value?.ToString(), out var sid) ? sid : null">
                    <option value="">No one</option>
                    @foreach (var p in salespeople) { <option value="@p.Id">@p.Name</option> }
                </select>
            }
            @if (brokers.Count > 0)
            {
                <h3>Broker</h3>
                <select id="broker" aria-label="Broker" value="@(brokerId?.ToString() ?? "")" @onchange="e => ChooseBroker(e.Value?.ToString())">
                    <option value="">No one</option>
                    @foreach (var p in brokers) { <option value="@p.Id">@p.Name</option> }
                </select>
                @if (brokerId is not null)
                {
                    <div class="row wrap">
                        <input id="broker-value" class="disc-in" inputmode="decimal" aria-label="Broker's commission" @bind="brokerValue" />
                        <select id="broker-unit" aria-label="Percent or amount" @bind="brokerUnit">
                            <option value="percent">percent</option>
                            <option value="amount">amount</option>
                        </select>
                        @if (brokerUnit == "percent")
                        {
                            <label class="check"><input id="broker-tax" type="checkbox" @bind="brokerWithTax" /> Count the tax too</label>
                        }
                    </div>
                }
            }

            @if (App.Loyalty.Enabled && customer is not null)
            {
                var balance = App.Loyalty.Balance(customer.Id);
                <div class="row wrap loyalty-row" id="loyalty-row">
                    <span>Points: <strong id="points">@PointsText(balance)</strong> (worth @Money(App.Loyalty.ValueOf(balance)))</span>
                    @if (balance > 0)
                    {
                        <input id="use-points" class="disc-in" inputmode="decimal" aria-label="Points to use" placeholder="Points to use" value="@(cart.Document.LoyaltyPointsUsedCent > 0 ? PointsText(cart.Document.LoyaltyPointsUsedCent) : "")" @onchange="e => UsePoints(e.Value?.ToString())" />
                    }
                </div>
            }

            <h3>Payment</h3>
            <div class="pay-methods" role="group" aria-label="Way of paying">
                @foreach (var m in Shop.PaymentMethods)
                {
                    <button type="button" class="chips-btn @(method == m ? "on" : "")" aria-pressed="@(method == m)" @onclick="() => method = m">@Label(m)</button>
                }
            </div>
            <input id="tender" class="big-input" inputmode="decimal" aria-label="Amount received" placeholder="@Shop.Text(Remaining)" @bind="tender" @bind:event="oninput" @onkeydown="OnPayKey" />
            <div class="row wrap">
                <button type="button" class="btn secondary" @onclick="AddPayment">Add payment</button>
                @if (Shop.Features.Credit && customer is { CreditLimitMinor: > 0 })
                {
                    <button type="button" class="btn secondary" @onclick="() => Complete(true)">Put on account</button>
                }
                @if (AccountCredit > 0 && Remaining > 0)
                {
                    <button type="button" class="btn secondary" id="use-credit" @onclick="UseCredit">Use credit on account (@Money(AccountCredit))</button>
                }
            </div>
            @foreach (var (p, i) in payments.Select((p, i) => (p, i)))
            {
                <div class="total-row"><span>@Label(p.Method)</span><span>@Money(p.AmountMinor) <button type="button" class="btn ghost small" aria-label="Take off this payment" @onclick="() => payments.RemoveAt(i)">×</button></span></div>
            }
            @if (Paid > cart.Document.PayableMinor && payments.Any(p => p.Method == "cash"))
            {
                <div class="total-row"><span>Change to give</span><strong id="change">@Money(Paid - cart.Document.PayableMinor)</strong></div>
            }
            else if (payments.Count > 0 && Remaining > 0)
            {
                <div class="total-row"><span>Still to pay</span><strong>@Money(Remaining)</strong></div>
            }
            <div class="row">
                <button type="button" class="btn primary grow" id="complete" @onclick="() => Complete(false)">Complete @Shop.Singular("sale").ToLowerInvariant()</button>
                <button type="button" class="btn ghost" id="save-estimate" @onclick="SaveEstimate">Keep as a quote</button>
                <button type="button" class="btn ghost" @onclick="Cancel">Cancel</button>
            </div>
        }
    </div>
</div>

@code {
    private string query = "";
    private string? category;
    private IReadOnlyList<Item> results = Array.Empty<Item>();
    private IReadOnlyList<string> categories = Array.Empty<string>();
    private DocumentView? cart;
    /// <summary>Names this till's sale to the main PC: pressing Pay twice, or a retry after a dropped connection, gives back the bill already made instead of making a second one.</summary>
    private readonly string saleKey = Guid.NewGuid().ToString("N");
    private Party? customer;
    private string customerQuery = "";
    private IReadOnlyList<NextGenOS.Hub.Catalog.ItemGroup> groups = Array.Empty<NextGenOS.Hub.Catalog.ItemGroup>();
    private IReadOnlyList<NextGenOS.Hub.Staff.Earner> salespeople = Array.Empty<NextGenOS.Hub.Staff.Earner>();
    private IReadOnlyList<NextGenOS.Hub.Staff.Earner> brokers = Array.Empty<NextGenOS.Hub.Staff.Earner>();
    private long? salespersonId;
    private long? brokerId;
    private string brokerValue = "";
    private string brokerUnit = "percent";
    private bool brokerWithTax;
    private string method = "cash";
    private string tender = "";
    private readonly List<PaymentInput> payments = new();
    private bool finished;
    private bool drawerPrinter;
    private string code = "";

    private void OnCodeKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") UseCode();
    }

    /// <summary>Puts a coupon or gift voucher on the sale. It is used up only when the bill is made.</summary>
    private void UseCode() => Run(() =>
    {
        if (cart is null) return;
        cart = App.Documents.ApplyCode(cart.Document.Id, code);
        code = "";
    });

    private void TakeOffCode(long voucherId) => Run(() => cart = App.Documents.RemoveCode(cart!.Document.Id, voucherId));

    private void LeaveOutOffer(bool leaveOut) => Run(() => cart = App.Documents.SetOfferDeclined(cart!.Document.Id, leaveOut));

    private Task OpenDrawer() => Run(async () => { await App.Printing.OpenDrawerAsync(null, Me.Id); });

    private long Paid => payments.Sum(p => p.AmountMinor);

    /// <summary>What the customer has with the shop already (an advance, or a return kept as credit), not yet counted in the payments below.</summary>
    private long AccountCredit => customer is null ? 0 : Math.Max(0, -AsMe(() => App.Books.CustomerBalance(customer.Id)) - payments.Where(p => p.Method == DocumentService.AccountCredit).Sum(p => p.AmountMinor));

    private void UseCredit() => Run(() => payments.Add(new PaymentInput { Method = DocumentService.AccountCredit, AmountMinor = Math.Min(AccountCredit, Remaining) }));
    private long Remaining => Math.Max(0, (cart?.Document.PayableMinor ?? 0) - Paid);

    private static string Label(string m) => m == DocumentService.AccountCredit ? "Credit on account" : char.ToUpperInvariant(m[0]) + m[1..];

    [SupplyParameterFromQuery(Name = "estimate")] public long? EstimateId { get; set; }

    private void SaveEstimate() => Run(() =>
    {
        if (cart is null) return;
        var quote = App.Documents.SaveAsEstimate(cart.Document.Id, Me.Id);
        finished = true;
        Nav.NavigateTo("/documents/" + quote.Document.Id + "?new=true");
    });

    protected override Task LoadAsync()
    {
        if (EstimateId is { } estimateId && cart is null)
        {
            // a bill started from a quote: the same customer and lines, ready to be paid
            try
            {
                cart = App.Documents.BillFromEstimate(estimateId, Me.Id);
                customer = cart.Party;
            }
            catch (HubException ex) { Error = ex.Message; }
        }
        method = Shop.PaymentMethods.Contains("cash") ? "cash" : Shop.PaymentMethods[0];
        categories = App.Catalog.Categories();
        groups = App.Groups.List();
        var earners = App.Earners.List();
        salespeople = earners.Where(e => e.Kind == NextGenOS.Hub.Staff.EarnerKinds.Salesperson).ToList();
        brokers = earners.Where(e => e.Kind == NextGenOS.Hub.Staff.EarnerKinds.Broker).ToList();
        drawerPrinter = App.PrinterProfiles.For("receipt") is not null;
        Search();
        return Task.CompletedTask;
    }

    private DotNetObjectReference<Sell>? self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Js.InvokeVoidAsync("hub.focus", "scan");
        self = DotNetObjectReference.Create(this);
        var map = TillKeys.Effective(Shop.Settings.ShortcutKeys).Where(k => TillKeys.Normalize(k.Value) is { Length: > 0 }).ToDictionary(k => TillKeys.Normalize(k.Value)!, k => k.Key);
        await Js.InvokeVoidAsync("hub.keys.start", self, map);
    }

    /// <summary>The keys in force, as the screen shows them: "F2 scan · F4 customer ...". Only what has a key.</summary>
    private string KeyHint() => string.Join(" · ", TillKeys.Actions
        .Select(a => (Key: TillKeys.Normalize(TillKeys.Effective(Shop.Settings.ShortcutKeys)[a.Id]), a.Short, a.Id))
        .Where(x => !string.IsNullOrEmpty(x.Key) && (x.Id != "drawer" || drawerPrinter))
        .Select(x => x.Key + " " + x.Short));

    /// <summary>A key of the till was pressed (the shop chose which key does what). It does what a tap would do, as the person signed in.</summary>
    [JSInvokable]
    public async Task OnTillKey(string action)
    {
        using var scope = App.Access.As(() => Me?.Id);
        switch (action)
        {
            case "scan": await Js.InvokeVoidAsync("hub.focus", "scan"); break;
            case "customer": await Js.InvokeVoidAsync("hub.focus", "customer-search"); break;
            case "amount": await Js.InvokeVoidAsync("hub.focus", "tender"); break;
            case "drawer": if (drawerPrinter) await OpenDrawer(); break;
            case "complete": if (cart is not null) Complete(false); break;
        }
        await InvokeAsync(StateHasChanged);
    }

    private void Search() => results = App.Catalog.Search(string.IsNullOrWhiteSpace(query) ? null : query, null, category, 60);

    private void PickCategory(string? c)
    {
        category = c;
        Search();
    }

    private async Task ScanFromCamera(string code)
    {
        query = code;
        await OnKey(new KeyboardEventArgs { Key = "Enter" });
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") { Search(); return; }
        await Run(() =>
        {
            var text = query.Trim();
            if (text.Length == 0) return;
            var item = App.Catalog.FindByCode(text);
            if (item is null)
            {
                Search();
                if (results.Count == 1) item = results[0];
            }
            if (item is null && App.Groups.FindByBarcode(text) is { } scannedGroup) { AddGroup(scannedGroup); return; }
            if (item is null) throw new HubException("not-found", $"Nothing is called \"{text}\".");
            Add(item);
        });
        await Js.InvokeVoidAsync("hub.focus", "scan");
    }

    private void Add(Item item) => Run(() => { AddItem(item, 1000); query = ""; Search(); });

    private void AddItem(Item item, long qtyMilli)
    {
        var existing = cart?.Lines.FirstOrDefault(l => l.ItemId == item.Id && !l.IsFree && l.Note is null && (l.DiscountSource is not null || (l.DiscountPctMilli == 0 && l.DiscountAmountMinor == 0)));
        if (cart is null)
            cart = App.Documents.CreateDraft(new DraftOptions { UserId = Me.Id, PartyId = customer?.Id, Lines = { new LineInput { ItemId = item.Id, QtyMilli = qtyMilli } } });
        else if (existing is not null)
            cart = App.Documents.UpdateLine(cart.Document.Id, existing.Id, existing.QtyMilli + qtyMilli);
        else
            cart = App.Documents.AddLine(cart.Document.Id, new LineInput { ItemId = item.Id, QtyMilli = qtyMilli });
    }

    /// <summary>A quick group: every item in it is added as a line of its own, at its own price, with its usual quantity.</summary>
    private void AddGroup(NextGenOS.Hub.Catalog.ItemGroup group) => Run(() =>
    {
        foreach (var m in group.Members)
        {
            var item = App.Catalog.Get(m.ItemId) ?? throw new HubException("group-item", $"{m.Name} was not found.");
            AddItem(item, m.QtyMilli);
        }
        query = "";
        Search();
    });

    private void Change(DocLine line, long delta)
    {
        Run(() =>
        {
            var next = line.QtyMilli + delta;
            cart = next <= 0 ? App.Documents.RemoveLine(cart!.Document.Id, line.Id) : App.Documents.UpdateLine(cart!.Document.Id, line.Id, next);
        });
    }

    private void SetQty(DocLine line, string? text)
    {
        Run(() =>
        {
            long milli;
            try { milli = ShopContext.QtyMilli((text ?? "").Trim()); }
            catch (FormatException) { throw new HubException("qty", "Please type a number, like 2 or 0.5."); }
            cart = milli <= 0 ? App.Documents.RemoveLine(cart!.Document.Id, line.Id) : App.Documents.UpdateLine(cart!.Document.Id, line.Id, milli);
        });
    }

    private void Remove(DocLine line) => Run(() => cart = App.Documents.RemoveLine(cart!.Document.Id, line.Id));

    // ---- discounts: "10%" is a percent, a plain number is an amount of money -------------------------------------------------------------------

    /// <summary>Owners and managers may always give a discount; a cashier may when the owner has set a limit above nothing (Settings).</summary>
    private bool CanDiscount => Me.Can(Perm.Discount) || Shop.Settings.CashierDiscountPctMilli > 0;

    private string LineDiscountText(DocLine line) =>
        line.DiscountPctMilli > 0 ? Qty(line.DiscountPctMilli) + "%" : line.DiscountAmountMinor > 0 ? Shop.Text(line.DiscountAmountMinor) : "";

    private string BillDiscountText() =>
        cart is null ? "" : cart.Document.BillDiscountPctMilli > 0 ? Qty(cart.Document.BillDiscountPctMilli) + "%" : cart.Document.BillDiscountMinor > 0 ? Shop.Text(cart.Document.BillDiscountMinor) : "";

    private void ParseDiscount(string? text, out long pctMilli, out long amountMinor)
    {
        pctMilli = 0;
        amountMinor = 0;
        var typed = (text ?? "").Trim();
        if (typed.Length == 0) return;
        try
        {
            if (typed.EndsWith('%')) pctMilli = ShopContext.QtyMilli(typed[..^1].Trim());
            else if (!TryMoney(Shop, typed, out amountMinor)) throw new FormatException();
        }
        catch (FormatException) { throw new HubException("discount", "Please type a discount like 10% or 25.50."); }
        if (pctMilli < 0 || amountMinor < 0) throw new HubException("discount", "A discount cannot be less than nothing.");
    }

    /// <summary>A cashier without the discount permission may not take off more than the owner's limit, counting every discount on the bill.</summary>
    private void KeepWithinLimit(Action putBack)
    {
        if (Me.Can(Perm.Discount) || cart?.Result is not { } result) return;
        // What counts against a cashier's limit is what a person typed: points, offers, coupons, the customer's own rate and free goods were all agreed beforehand.
        var automatic = cart.Lines.Where(l => l.IsFree || l.DiscountSource is not null).Sum(DocumentService.LineDiscountOf);
        var gross = Shop.Minor(result.Totals.Gross) - cart.Lines.Where(l => l.IsFree).Sum(l => DocumentService.Gross(l.QtyMilli, l.UnitPriceMinor));
        var off = Shop.Minor(result.Totals.Discount) - cart.Document.LoyaltyDiscountMinor - cart.Document.OfferDiscountMinor - automatic;
        var limit = Shop.Settings.CashierDiscountPctMilli;
        if (gross > 0 && (decimal)off * 100_000m > (decimal)limit * gross)
        {
            putBack();
            throw new HubException("discount-limit", $"A cashier may take off up to {Qty(limit)}% of a bill. Ask a manager for more.");
        }
    }

    private void SetLineDiscount(DocLine line, string? text)
    {
        Run(() =>
        {
            ParseDiscount(text, out var pct, out var amount);
            var (beforePct, beforeAmount) = (line.DiscountPctMilli, line.DiscountAmountMinor);
            cart = App.Documents.UpdateLine(cart!.Document.Id, line.Id, discountPctMilli: pct, discountAmountMinor: amount);
            KeepWithinLimit(() => cart = App.Documents.UpdateLine(cart!.Document.Id, line.Id, discountPctMilli: beforePct, discountAmountMinor: beforeAmount));
        });
    }

    private static string PointsText(long cent) => (cent / 100m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private void UsePoints(string? text) => Run(() =>
    {
        var milli = NextGenOS.Hub.Loyalty.LoyaltyService.ParseMilli(text);
        if (!string.IsNullOrWhiteSpace(text) && (milli <= 0 || milli % 10 != 0)) throw new HubException("loyalty", "Please type the points as a number, like 20 or 12.5.");
        cart = App.Documents.SetLoyaltyPoints(cart!.Document.Id, milli / 10);
    });

    private void SetBillDiscount(string? text)
    {
        Run(() =>
        {
            ParseDiscount(text, out var pct, out var amount);
            var (beforePct, beforeAmount) = (cart!.Document.BillDiscountPctMilli, cart.Document.BillDiscountMinor);
            cart = App.Documents.SetBillDiscount(cart.Document.Id, amount, pct);
            KeepWithinLimit(() => cart = App.Documents.SetBillDiscount(cart!.Document.Id, beforeAmount, beforePct));
        });
    }

    private IEnumerable<NextGenOS.Tax.Component> TaxParts() => cart?.Result?.Totals.Components?.Where(c => Shop.Minor(c.Amount) != 0) ?? Enumerable.Empty<NextGenOS.Tax.Component>();

    private void PickCustomer(Party p)
    {
        Run(() =>
        {
            customer = p;
            customerQuery = "";
            payments.RemoveAll(x => x.Method == DocumentService.AccountCredit);
            if (cart is not null) cart = App.Documents.SetParty(cart.Document.Id, p.Id);
            Search();
        });
    }

    private void ClearCustomer()
    {
        Run(() =>
        {
            customer = null;
            payments.RemoveAll(x => x.Method == DocumentService.AccountCredit);
            if (cart is not null) cart = App.Documents.SetParty(cart.Document.Id, null);
            Search();
        });
    }

    /// <summary>Choosing a broker fills in the broker's usual commission, to be changed for this bill.</summary>
    private void ChooseBroker(string? text)
    {
        brokerId = long.TryParse(text, out var id) ? id : null;
        var usual = brokers.FirstOrDefault(b => b.Id == brokerId)?.PctMilli ?? 0;
        brokerValue = usual > 0 ? Qty(usual) : "";
        brokerUnit = "percent";
        brokerWithTax = false;
    }

    /// <summary>Names the salesperson and the broker on the bill just before it is made final (nothing is needed when the shop has none).</summary>
    private void NameEarners()
    {
        if (cart is null || (salespeople.Count == 0 && brokers.Count == 0)) return;
        if (salespeople.Count > 0) App.Earners.ChooseSalesperson(cart.Document.Id, salespersonId);
        if (brokers.Count == 0) return;
        if (brokerId is not { } broker) { App.Earners.ChooseBroker(cart.Document.Id, null); return; }
        var value = brokerValue.Trim().TrimEnd('%').Trim();
        if (value.Length == 0) throw new HubException("broker-how", "Please type the broker's commission, as a percent or as an amount.");
        if (brokerUnit == "percent")
        {
            long pct;
            try { pct = ShopContext.QtyMilli(value); }
            catch (FormatException) { throw new HubException("earner-percent", "Please type the broker's commission as a percent, like 2.5."); }
            App.Earners.ChooseBroker(cart.Document.Id, broker, brokerWithTax, pctMilli: pct);
        }
        else
        {
            if (!TryMoney(Shop, value, out var amount)) throw new HubException("broker-amount", "Please type the broker's commission as an amount, like 250 or 99.50.");
            App.Earners.ChooseBroker(cart.Document.Id, broker, false, amountMinor: amount);
        }
    }

    private void OnPayKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddPayment();
    }

    private void AddPayment()
    {
        Run(() =>
        {
            long amount;
            if (string.IsNullOrWhiteSpace(tender)) amount = Remaining;
            else if (!TryMoney(Shop, tender, out amount) || amount <= 0) throw new HubException("amount", "Please type the amount as a number, like 250 or 99.50.");
            if (amount <= 0) throw new HubException("amount", "There is nothing left to pay.");
            payments.Add(new PaymentInput { Method = method, AmountMinor = amount });
            tender = "";
        });
    }

    private void Complete(bool onAccount)
    {
        Run(() =>
        {
            if (cart is null) return;
            if (!onAccount && tender.Trim().Length > 0) AddPayment();
            if (!onAccount && payments.All(p => p.Method == DocumentService.AccountCredit) && Remaining > 0) payments.Add(new PaymentInput { Method = method, AmountMinor = Remaining });   // nothing typed (or only the customer's credit): the rest is taken in the way chosen
            try { NameEarners(); }
            catch (HubException ex) when (ex.Code == "not-open") { /* pressed twice, or a retry after a dropped connection: the bill is already made, and the key below gives it back */ }
            var done = App.Documents.Issue(cart.Document.Id, new IssueOptions { Payments = payments.ToList(), UserId = Me.Id, OnCredit = onAccount, RequestKey = saleKey });
            finished = true;
            Nav.NavigateTo("/documents/" + done.Document.Id + "?new=true");
        });
    }

    private void Cancel()
    {
        Run(() =>
        {
            if (cart is not null) App.Documents.Discard(cart.Document.Id);
            cart = null;
            payments.Clear();
            tender = "";
        });
    }

    public void Dispose()
    {
        try { _ = Js.InvokeVoidAsync("hub.keys.stop"); } catch (Exception) { /* the connection is gone already */ }
        self?.Dispose();
        // A sale left open by closing the page is thrown away, so it does not clutter the day.
        if (cart is not null && !finished)
        {
            try
            {
                using var asMe = App.Access.As(Me.Id);
                App.Documents.Discard(cart.Document.Id);
            }
            catch (Exception) { /* the daily clean-up will take it */ }
        }
    }
}

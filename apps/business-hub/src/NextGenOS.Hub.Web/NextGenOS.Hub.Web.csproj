<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The Business Hub's screens: sign in, set up the shop, and work (counter, tables and kitchen, library desk, projects, bookings, stock, reports).
       It runs on the shop's own PC and is opened in a browser. It starts only with a valid NextGenOS licence that includes the "hub" module. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NextGenOS.Hub</AssemblyName>
    <RootNamespace>NextGenOS.Hub.Web</RootNamespace>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- A mistyped component name would silently become a plain HTML tag: make it a build error. -->
    <WarningsAsErrors>$(WarningsAsErrors);RZ10012</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NextGenOS.Hub.Core\NextGenOS.Hub.Core.csproj" />
    <ProjectReference Include="..\..\..\..\licensing\clients\dotnet\NextGenOS.Licensing\NextGenOS.Licensing.csproj" />
    <ProjectReference Include="..\..\..\..\licensing\clients\dotnet\NextGenOS.Licensing.AspNetCore\NextGenOS.Licensing.AspNetCore.csproj" />
  </ItemGroup>

  <!-- The design values every NextGenOS program shares (design/tokens.css), built into the program and served as /tokens.css beside the Hub's own style. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\design\tokens.css" LogicalName="tokens.css" />
    <InternalsVisibleTo Include="NextGenOS.Hub.Web.Tests" />
  </ItemGroup>
  <!-- The Hub carries its own copy of the language data (ICU), so that sorting and the older-system reader work the same on every PC and nothing has to be installed first
       (CLAUDE.md section 6). The version below is the one of the package. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" />
  </ItemGroup>
  <!-- Where this copy looks for updates, and whose signed statement it trusts (the repository, its owner and the release workflow, by GitHub's own numbers). The release build writes them
       into the program (installer/build.mjs); they are never read from a setting or a file on the PC. Without all four a copy never looks for updates. -->
  <ItemGroup Condition="'$(UpdateFeed)' != '' And '$(ReleaseRepositoryId)' != '' And '$(ReleaseOwnerId)' != '' And '$(ReleaseWorkflow)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>UpdateFeed</_Parameter1><_Parameter2>$(UpdateFeed)</_Parameter2></AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>ReleaseRepositoryId</_Parameter1><_Parameter2>$(ReleaseRepositoryId)</_Parameter2></AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>ReleaseOwnerId</_Parameter1><_Parameter2>$(ReleaseOwnerId)</_Parameter2></AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>ReleaseWorkflow</_Parameter1><_Parameter2>$(ReleaseWorkflow)</_Parameter2></AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The Business Hub's screens: sign in, set up the shop, and work (counter, tables and kitchen, library desk, projects, bookings, stock, reports).
       It runs on the shop's own PC and is opened in a browser. It starts only with a valid NextGenOS licence that includes the "hub" module. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NextGenOS.Hub</AssemblyName>
    <RootNamespace>NextGenOS.Hub.Web</RootNamespace>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NextGenOS.Hub.Core\NextGenOS.Hub.Core.csproj" />
    <ProjectReference Include="..\..\..\..\licensing\clients\dotnet\NextGenOS.Licensing\NextGenOS.Licensing.csproj" />
    <ProjectReference Include="..\..\..\..\licensing\clients\dotnet\NextGenOS.Licensing.AspNetCore\NextGenOS.Licensing.AspNetCore.csproj" />
  </ItemGroup>

  <!-- The design values every NextGenOS program shares (design/tokens.css), served beside the Hub's own style. -->
  <ItemGroup>
    <Content Include="..\..\..\..\design\tokens.css" Link="wwwroot\tokens.css" />
    <InternalsVisibleTo Include="NextGenOS.Hub.Web.Tests" />
  </ItemGroup>

</Project>

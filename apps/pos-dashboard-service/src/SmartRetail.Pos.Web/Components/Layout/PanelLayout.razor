@* The side panel beside the POS, and Get started: no sidebar. In the app window, Get started has the window's top bar
   with just its name and buttons; the side panel never shows it. *@
@inherits LayoutComponentBase

<WindowBar Full="false" />

@Body

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong on this screen.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

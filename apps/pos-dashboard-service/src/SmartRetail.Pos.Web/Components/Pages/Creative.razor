    private async Task ExportAsync(CreativeGeneration generation)
    {
        exporting = true;
        message = null;
        try
        {
            await LoadTagsAsync();
            if (tags.Problems.Count > 0)
            {
                return;
            }

            var format = CreativeFormat.Find(generation.Brief.Format);
            var places = TagPlaces(generation, format);
            var (background, words) = TagLayout.Colours(brand.Colours.FirstOrDefault());
            var spec = new
            {
                width = format.Width,
                height = format.Height,
                picture = Nav.ToAbsoluteUri($"creative-files/{Id}/picture/{generation.Number}").ToString(),
                tags = tags.Tags.Select((tag, i) => new
                {
                    x = places[i].X,
                    y = places[i].Y,
                    name = tag.Name,
                    pays = Formats.Price(tag.Pays),
                    was = tag.Offer is null ? null : Formats.Price(tag.Price),
                    off = tag.Offer is null ? null : tag.PercentOff.ToString("0", CultureInfo.InvariantCulture) + "% off",
                    @long = Formats.Price(tag.Pays).Length > 6,
                    background,
                    words,
                }).ToList(),
            };
            await using var png = await Js.InvokeAsync<IJSStreamReference>("srposCreative.render", stopping.Token, spec);
            await using var stream = await png.OpenReadStreamAsync(40L * 1024 * 1024, stopping.Token);
            var name = await Service.SaveExportAsync(Id, generation.Number, stream, stopping.Token);
            await Js.InvokeVoidAsync("srposCreative.download", $"creative-files/{Id}/export/{name}", name);
            Show($"Exported as {name}, {format.Size}, with today's prices. A copy is kept with the creative.", problem: false);
        }
        catch (Exception ex) when (ex is CreativeException or JSException or IOException or UnauthorizedAccessException)
        {
            Log.LogWarning(ex, "Exporting a creative failed.");
            Show(ex is JSException ? "The picture could not be exported: " + ex.Message : ex.Message, problem: true);
        }
        finally
        {
            exporting = false;
        }
    }


    private string Pictures()
    {
        var made = project!.Generations.Count(g => g.HasImage);
        return made == 0 ? "no picture yet" : made == 1 ? "1 picture" : $"{made} pictures";
    }

    private static string Percent(double share) => (share * 100).ToString("0.##", CultureInfo.InvariantCulture);

    private static string Duration(double seconds) =>
        seconds < 90 ? $"{seconds:0} s" : $"{Math.Floor(seconds / 60):0} min {seconds % 60:0} s";

    public async ValueTask DisposeAsync()
    {
        Service.Changed -= OnChanged;
        await stopping.CancelAsync();
        stopping.Dispose();
        self?.Dispose();
    }

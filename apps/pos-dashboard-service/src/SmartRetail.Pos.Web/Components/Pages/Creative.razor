        || !string.IsNullOrEmpty(brief.Background) || !string.IsNullOrEmpty(brief.Instructions) || brief.References.Count > 0;

    private RenderFragment WordInput(string id, string label, string value, int max, string placeholder, Func<string, Func<CreativeBrief, CreativeBrief>> edit) =>
        @<div class="word-field">
            <label class="field-label" for="@id">@label</label>
            <input id="@id" class="form-control" maxlength="@max" placeholder="@placeholder" value="@value"
                   @onchange="@(e => SaveAsync(edit(Text(e))))" />
            @if (CreativeWords.Problem(label, value, max) is { } wordProblem)
            {
                <div class="item-meta bad-note">@wordProblem</div>
            }
        </div>;

    private Task SetOfferAsync(int productId, string? value)
    {
        decimal? offer = decimal.TryParse(value, NumberStyles.Number, CultureInfo.InvariantCulture, out var amount) ? amount : null;
        return SaveAsync(b => b with { Products = b.Products.Select(p => p.ProductId == productId ? p with { Offer = offer } : p).ToList() });
    }

    private async Task SearchAsync(ChangeEventArgs e)
    {
        term = e.Value?.ToString() ?? "";
        var mine = ++searchVersion;
        if (term.Trim().Length == 0)
        {
            found = Array.Empty<Product>();
            return;
        }

        await Task.Delay(200);
        if (mine != searchVersion)
        {
            return;
        }

        try
        {
            var results = await Catalog.SearchAsync(term.Trim(), SearchLimit, stopping.Token);
            if (mine == searchVersion)
            {
                found = results.Where(p => brief.Products.All(c => c.ProductId != p.Id)).ToList();
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Log.LogWarning(ex, "Finding products for a creative failed.");
            Show("Could not search the products: " + ex.Message, problem: true);
        }
    }

    private Task AddProductAsync(int productId)
    {
        term = "";
        found = Array.Empty<Product>();
        return SaveAsync(b => b with { Products = b.Products.Append(new CreativeItem(productId)).ToList() });
    }

    private Task RemoveProductAsync(int productId) =>

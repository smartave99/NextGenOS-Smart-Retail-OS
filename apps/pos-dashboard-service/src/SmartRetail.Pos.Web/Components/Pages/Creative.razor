    private void OnChanged(string id)
    {
        if (id != Id)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            var wasMaking = Making;
            project = Service.Store.Load(Id);
            status = Service.Status(Id);
            if (project is not null && wasMaking && !Making)
            {
                await LoadTagsAsync();
            }

            StateHasChanged();
        });
    }


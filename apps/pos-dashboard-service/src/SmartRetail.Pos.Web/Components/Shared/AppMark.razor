@* The app's icon: a sparkle on a violet-to-blue square. The same drawing is the Windows icon and the favicon. *@
<svg class="brand-mark @Class" viewBox="0 0 64 64" width="@Size" height="@Size" aria-hidden="true" focusable="false">
    <defs>
        <linearGradient id="@gradient" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#7a5cff" />
            <stop offset=".55" stop-color="#2f7bff" />
            <stop offset="1" stop-color="#18b6f6" />
        </linearGradient>
    </defs>
    <rect width="64" height="64" rx="15" fill="url(#@gradient)" />
    <path d="M28 14c1.6 11.6 6.4 16.4 19 19-12.6 2.6-17.4 7.4-19 19-1.6-11.6-6.4-16.4-19-19 12.6-2.6 17.4-7.4 19-19z" fill="#fff" />
    <path d="M47 9.5c.7 4.7 2.6 6.6 7.5 7.5-4.9.9-6.8 2.8-7.5 7.5-.7-4.7-2.6-6.6-7.5-7.5 4.9-.9 6.8-2.8 7.5-7.5z" fill="#fff" opacity=".9" />
</svg>

@code {
    // Each mark its own: a gradient in a hidden copy (e.g. the app window's top bar in a browser) draws nothing.
    private readonly string gradient = "app-mark-" + Guid.NewGuid().ToString("N")[..8];

    [Parameter] public int Size { get; set; } = 30;
    [Parameter] public string? Class { get; set; }
}

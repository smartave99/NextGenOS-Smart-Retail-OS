@* Quiet actions under an answer: copy it, ask the same question again, see how it was found (the read-only query),
   and who answered. *@
@using SmartRetail.AI.Assistant
@implements IDisposable
@inject IJSRuntime Js
@inject WorkService Plan

@if (WaitingProposal is { } waiting)
{
    <div class="msg-actions work-waiting" role="group" aria-label="Suggested for your plan">
        <span class="act-meta">@(waiting.Changes.Count == 1 ? "1 suggestion" : waiting.Changes.Count + " suggestions") for your plan, not saved yet</span>
        <button type="button" class="act" @onclick="() => SavePlan(waiting)"><Icon Name="check" /><span>Save to my plan</span></button>
        <button type="button" class="act" @onclick="() => RejectPlan(waiting)"><Icon Name="close" /><span>Don’t save</span></button>
        <a class="act" href="work"><Icon Name="calendar" /><span>Open Plan &amp; tasks</span></a>
        @if (planProblem is not null)
        {
            <span class="act-meta" role="alert">@planProblem</span>
        }
    </div>
}

<div class="msg-actions">
    @if (!Message.IsProblem && !Message.WasStopped && Message.Text.Length > 0)
    {
        <button type="button" class="act" title="Copy the answer" @onclick="CopyAsync">
            <Icon Name="@(copied ? "check" : "copy")" /><span>@(copied ? "Copied" : "Copy")</span>
        </button>
    }
    @if (Question is not null && AskAgain is not null)
    {
        <button type="button" class="act" title="Ask the same question again" disabled="@Busy" @onclick="() => AskAgain(Question.Text, Question.Attachments)">
            <Icon Name="refresh" /><span>Ask again</span>
        </button>
    }
    @if (Message.Sql is not null)
    {
        <button type="button" class="act" aria-expanded="@(showSql ? "true" : "false")" @onclick="() => showSql = !showSql">
            <Icon Name="database" /><span>How this was found</span>
        </button>
    }
    @if (Message.Source is { Length: > 0 } source)
    {
        <span class="act-meta">@source</span>
    }
</div>
@if (showSql && Message.Sql is { } sql)
{
    <div class="msg-sql">
        <p class="muted small">The read-only query the AI wrote. It was checked, and run in a transaction that was undone.</p>
        <CodeBlock Code="@sql" Language="SQL" />
    </div>
}

@code {
    private readonly CancellationTokenSource gone = new();
    private bool copied;
    private bool showSql;

    [Parameter, EditorRequired] public ChatMessage Message { get; set; } = default!;

    /// <summary>The question this answers, to ask again with its photos and voice notes; null when there is none.</summary>
    [Parameter] public ChatMessage? Question { get; set; }

    [Parameter] public Func<string, IReadOnlyList<ChatAttachment>, bool>? AskAgain { get; set; }

    [Parameter] public bool Busy { get; set; }

    /// <summary>What this answer suggested for the plan, if the owner has not yet said Save or Don't save.</summary>
    private SmartRetail.AI.Work.WorkProposal? WaitingProposal =>
        Message.WorkProposalId is { Length: > 0 } id ? Plan.Load().Pending.FirstOrDefault(p => p.Id == id) : null;

    private string? planProblem;

    private void SavePlan(SmartRetail.AI.Work.WorkProposal proposal)
    {
        try
        {
            var result = Plan.Approve(proposal.Id);
            planProblem = result.Problems.Count > 0 ? "Not everything could be saved: " + string.Join("; ", result.Problems) : null;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException)
        {
            planProblem = "It was not saved: " + ex.Message;
        }
    }

    private void RejectPlan(SmartRetail.AI.Work.WorkProposal proposal)
    {
        try
        {
            Plan.Reject(proposal.Id);
            planProblem = null;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException)
        {
            planProblem = "That could not be done: " + ex.Message;
        }
    }

    private void OnPlanChanged() => _ = InvokeAsync(StateHasChanged);

    protected override void OnInitialized() => Plan.Changed += OnPlanChanged;

    private async Task CopyAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("srpos.copy", Message.Text);
            copied = true;
            StateHasChanged();
            await Task.Delay(2000, gone.Token);
            copied = false;
        }
        catch (Exception ex) when (ex is JSException or TaskCanceledException or JSDisconnectedException)
        {
            copied = false;
        }
    }

    public void Dispose()
    {
        Plan.Changed -= OnPlanChanged;
        gone.Cancel();
        gone.Dispose();
    }
}

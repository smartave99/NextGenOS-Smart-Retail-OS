<svg class="icon @Class" viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "house":
            <path d="M3.5 10.5 12 3.5l8.5 7" /><path d="M5.5 9v11h13V9" /><path d="M10 20v-5.5h4V20" />
            break;
        case "dashboard":
            <rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" />
            <rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" />
            break;
        case "bill":
            <path d="M6 3.5h12V21l-3-2-3 2-3-2-3 2z" /><path d="M9 8h6M9 12h6M9 16h3" />
            break;
        case "bills":
            <path d="M9 6h11M9 12h11M9 18h11" /><circle cx="4.5" cy="6" r="1" /><circle cx="4.5" cy="12" r="1" /><circle cx="4.5" cy="18" r="1" />
            break;
        case "products":
            <path d="M3.5 7.5 12 3.5l8.5 4v9l-8.5 4-8.5-4z" /><path d="M3.5 7.5 12 12l8.5-4.5M12 12v8.5" />
            break;
        case "stock":
            <path d="M12 3.5 2.5 20h19z" /><path d="M12 10v4.5M12 17.2v.1" />
            break;
        case "chart":
            <path d="M3.5 20h17" /><path d="M6 16.5v-5M10.5 16.5V7M15 16.5v-7.5M19.5 16.5V4.5" />
            break;
        case "trend":
            <path d="M3.5 17l6-6 4 4 7-7" /><path d="M14.5 8h6v6" />
            break;
        case "spark":
            <path d="M11 3.5l1.7 4.6 4.6 1.7-4.6 1.7L11 16.1l-1.7-4.6-4.6-1.7 4.6-1.7z" /><path d="M18.5 14.5l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z" />
            break;
        case "camera":
            <path d="M4 8h3l2-3h6l2 3h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z" /><circle cx="12" cy="13.5" r="3.5" />
            break;
        case "lens":
            <path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2" /><circle cx="12" cy="12" r="3.5" />
            break;
        case "news":
            <path d="M5 4.5h11a1.5 1.5 0 0 1 1.5 1.5v14H6.5A1.5 1.5 0 0 1 5 18.5z" /><path d="M17.5 8.5h1A1.5 1.5 0 0 1 20 10v8a2 2 0 0 1-2 2" /><path d="M8.5 8.5h6M8.5 12h6M8.5 15.5h4" />
            break;
        case "image":
            <rect x="3.5" y="4.5" width="17" height="15" rx="2.5" /><circle cx="9" cy="10" r="1.8" /><path d="m4 17.5 5-5 4 4 2.5-2.5 5 5" />
            break;
        case "mic":
            <rect x="9" y="3.5" width="6" height="11" rx="3" /><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v2.5" />
            break;
        case "poster":
            <rect x="4.5" y="2.5" width="15" height="19" rx="2" /><circle cx="9.5" cy="8" r="1.8" /><path d="M4.5 16l4.5-4 4 3.5 2.5-2 4 3.5" />
            break;
        case "folder":
            <path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h4l2 2.5h9A1.5 1.5 0 0 1 21 9v9.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5z" />
            break;
        case "sliders":
            <path d="M4 7h9M17 7h3M4 12h3M11 12h9M4 17h11M19 17h1" /><circle cx="15" cy="7" r="2" /><circle cx="9" cy="12" r="2" /><circle cx="17" cy="17" r="2" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.6-3.6" />
            break;
        case "trash":
            <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" />
            break;
        case "user":
            <circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6" />
            break;
        case "printer":
            <path d="M6 9V3.5h12V9" /><rect x="3" y="9" width="18" height="8" rx="2" /><path d="M7 14h10v6.5H7z" />
            break;
        case "check":
            <path d="m5 12.5 4.5 4.5L19 7.5" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "minus":
            <path d="M5 12h14" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
        case "download":
            <path d="M12 4v11M7.5 10.5 12 15l4.5-4.5" /><path d="M5 19.5h14" />
            break;
        case "upload":
            <path d="M12 15.5V4.5M7.5 9 12 4.5 16.5 9" /><path d="M5 19.5h14" />
            break;
        case "arrow-up":
            <path d="M12 19V5M6 11l6-6 6 6" />
            break;
        case "stop":
            <rect x="7" y="7" width="10" height="10" rx="2" fill="currentColor" stroke="none" />
            break;
        case "copy":
            <rect x="8.5" y="8.5" width="12" height="12" rx="2.5" /><path d="M15.5 8.5V6a2.5 2.5 0 0 0-2.5-2.5H6A2.5 2.5 0 0 0 3.5 6v7A2.5 2.5 0 0 0 6 15.5h2.5" />
            break;
        case "external":
            <path d="M14 4h6v6M20 4l-8.5 8.5" /><path d="M18 14v4.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10" />
            break;
        case "alert":
            <circle cx="12" cy="12" r="9" /><path d="M12 7.5v5.5M12 16.4v.1" />
            break;
        case "barcode":
            <path d="M4 6v12M7.5 6v12M13 6v12M20 6v12" /><path d="M10 6v12M16.5 6v12" stroke-width="3" />
            break;
        case "chevron":
            <path d="m9 6 6 6-6 6" />
            break;
        case "shield":
            <path d="M12 3 5 6v5.5c0 4.2 3 7.9 7 9.5 4-1.6 7-5.3 7-9.5V6z" /><path d="m9 12 2.2 2.2L15.5 10" />
            break;
        case "expand":
            <path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7" />
            break;
        case "info":
            <circle cx="12" cy="12" r="8.5" /><path d="M12 11v5M12 7.8v.1" />
            break;
        case "lock":
            <rect x="5" y="11" width="14" height="9.5" rx="2" /><path d="M8 11V7.5a4 4 0 0 1 8 0V11" />
            break;
        case "refresh":
            <path d="M20 11a8 8 0 0 0-14.5-4.5L4 8" /><path d="M4 3.5V8h4.5" /><path d="M4 13a8 8 0 0 0 14.5 4.5L20 16" /><path d="M20 20.5V16h-4.5" />
            break;
        case "person":
            <circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6" />
            break;
        case "database":
            <ellipse cx="12" cy="5.5" rx="7.5" ry="2.5" /><path d="M4.5 5.5v13c0 1.4 3.4 2.5 7.5 2.5s7.5-1.1 7.5-2.5v-13" /><path d="M4.5 12c0 1.4 3.4 2.5 7.5 2.5s7.5-1.1 7.5-2.5" />
            break;
        case "sun":
            <circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2.5 12h2M19.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
            break;
        case "moon":
            <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
            break;
        case "tag":
            <path d="M3.5 12.5V4.5a1 1 0 0 1 1-1h8l8 8-9 9z" /><circle cx="8" cy="8" r="1.5" />
            break;
        case "panel":
            <rect x="3" y="4.5" width="18" height="15" rx="2.5" /><path d="M15 4.5v15" />
            break;
        case "history":
            <path d="M3.5 12a8.5 8.5 0 1 0 2.4-5.9" /><path d="M3.5 4.5V9H8" /><path d="M12 7.5V12l3 2" />
            break;
        case "flag":
            <path d="M5 21V4" /><path d="M5 4.5h11.5l-2 4 2 4H5" />
            break;
        case "memory":
            <path d="M6.5 3.5h11A1.5 1.5 0 0 1 19 5v14.5a1 1 0 0 1-1 1H6.5a2 2 0 0 1-2-2v-13a2 2 0 0 1 2-2z" /><path d="M4.5 18.5a2 2 0 0 1 2-2H19" /><path d="M9 8h6M9 11.5h4" />
            break;
        case "undo":
            <path d="M9 14 4 9l5-5" /><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11" />
            break;
        case "bell":
            <path d="M6 9.5a6 6 0 0 1 12 0c0 6.5 2.5 8 2.5 8h-17S6 16 6 9.5z" /><path d="M10 20.5a2.2 2.2 0 0 0 4 0" />
            break;
        case "edit":
            <path d="M4 20h4L19 9l-4-4L4 16z" /><path d="m13.5 6.5 4 4" />
            break;
        case "calendar":
            <rect x="3.5" y="5" width="17" height="15.5" rx="2" /><path d="M3.5 10h17" /><path d="M8 3v4M16 3v4" /><path d="M8 14h2M14 14h2M8 17h2" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 18;
    [Parameter] public string? Class { get; set; }
}

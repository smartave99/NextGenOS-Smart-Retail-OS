@inject DataSourceInfo Source

<div class="panel load-error" role="alert">
    <strong>Couldn't read the shop's data.</strong>
    <p>@Message</p>
    @if (!Source.IsDemo)
    {
        <p class="muted">Check that SQL Server is running on this PC and that the connection string in appsettings.Local.json is right.</p>
    }
    <button class="btn btn-outline-secondary btn-sm" @onclick="OnRetry">Try again</button>
</div>

@code {
    [Parameter, EditorRequired] public string Message { get; set; } = "";
    [Parameter] public EventCallback OnRetry { get; set; }
}

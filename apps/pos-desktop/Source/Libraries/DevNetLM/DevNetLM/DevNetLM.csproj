<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DevNetLM: the licence manager of the Windows POS. The name and the public API stay (the POS calls DevNet.Validate() and
    DevNet.ShowActivation()), but everything underneath is new: it uses NextGenOS.Licensing (signed licences, activation bound
    to the PC, revocation, offline codes). The old hard-coded key, the registry store and the Firebase licence database are gone.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>DevNetLM</AssemblyName>
    <RootNamespace>DevNetLM</RootNamespace>
    <Company>NextGenOS</Company>
    <Product>Smart Retail POS</Product>
    <Copyright>© 2026 NextGenOS. All rights reserved.</Copyright>
    <Version>2.0.0</Version>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ApplicationIcon>DevNetLM.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\..\licensing\clients\dotnet\NextGenOS.Licensing\NextGenOS.Licensing.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
  </ItemGroup>

</Project>

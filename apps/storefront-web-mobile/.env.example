# Groq handles every text and vision LLM workload.
# Never commit real values. Configure secrets in the deployment environment or
# through the authenticated admin key screen.
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_TEXT_MODEL_PRIMARY=qwen/qwen3.8-27b
GROQ_TEXT_MODEL_FALLBACK=qwen/qwen3.6-27b
GROQ_VISION_MODEL_PRIMARY=qwen/qwen3.8-27b
GROQ_VISION_MODEL_FALLBACK=qwen/qwen3.6-27b
# Optional TEXT models tried after GPT-OSS 120B and GPT-OSS 20B.
GROQ_MODEL_FALLBACKS=
# Optional VISION-capable fallback models only. Do not put GPT-OSS here.
GROQ_VISION_MODEL_FALLBACKS=
GROQ_TEXT_CACHE_TTL_SECONDS=300
GROQ_MODEL_WHISPER=whisper-large-v3-turbo

# Legacy provider values are retained only so existing deployments can be
# migrated safely. They are not used by the LLM router.
LIGHTNING_API_KEY=
LIGHTNING_API_KEY_1=
LIGHTNING_API_KEY_2=
LIGHTNING_API_KEY_3=
LIGHTNING_API_KEY_4=
LIGHTNING_API_KEY_5=
LIGHTNING_API_KEY_6=
LIGHTNING_API_KEY_7=
LIGHTNING_API_KEY_8=
LIGHTNING_API_KEY_9=
LIGHTNING_API_KEY_10=
LIGHTNING_MODEL=lightning-ai/deepseek-v4-pro
LIGHTNING_MODEL_REASONING=lightning-ai/deepseek-v4-pro
LIGHTNING_MODEL_GIFT=lightning-ai/deepseek-v4-pro
LIGHTNING_VISION_MODEL=lightning-ai/gemma-4-31B-it
LIGHTNING_VISION_FALLBACK_MODEL=lightning-ai/nvidia-nemotron-3-nano-omni-30b-a3b

# OpenAI-compatible Lightning Model API base. The application appends
# /chat/completions automatically. A complete endpoint is also accepted.
LIGHTNING_API_BASE_URL=https://lightning.ai/api/v1/

# Groq does not provide vector embeddings. Gemini is isolated to text-to-vector
# generation for pgvector search; it is never used for chat or vision.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional distributed application cache. Without these, a process-local cache
# is used and will not be shared across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Live shop (admin panel, /admin/live): the shop's figures from the POS, live, from the owner's own Supabase
# project, where the shop PC running Smart Retail POS sends them. Both values are public by design (every visitor's
# browser receives them); Supabase: Project Settings, then Data API (URL) and API Keys (the publishable key).
# Never put the secret key (sb_secret_... or service_role) here: the page refuses it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Set up for each customer (nothing about a customer is built into the code) ----
# The shop's name and public address.
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_URL=
# The shop's country: a two-letter code with a pack in country-packs/ (IN, PH, GB, US ...). It sets the currency, the way numbers and
# dates are written, and the language of the assistant. See country-packs/README.md.
NEXT_PUBLIC_COUNTRY=IN
# The kind of business: retail, restaurant, library, construction, services, wholesale or generic (industry-packs/). It sets the words
# the website uses (Products, Menu items, Titles ...).
NEXT_PUBLIC_INDUSTRY=retail
# The town or area of the shop, as the website should say it (for example "Patna, India"). Optional.
NEXT_PUBLIC_SHOP_PLACE=
# Who may open the admin pages before any staff member exists (comma separated; each must sign in with a verified e-mail).
OWNER_ADMIN_EMAILS=
# The licence of this website: the text of the .ngoslic file from NextGenOS (or put it in LICENCE_DIR/licence.ngos).
NGOS_LICENCE=
LICENCE_DIR=
# Encrypts the AI service keys kept in the database (32 random bytes, base64). Keep it only here; losing it means entering the keys again.
# Make one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NGOS_DATA_KEY=

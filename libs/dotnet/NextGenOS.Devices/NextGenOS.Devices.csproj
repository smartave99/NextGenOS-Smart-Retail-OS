<Project Sdk="Microsoft.NET.Sdk">

  <!-- Talking to the shop's devices: receipt and label printers in any of their languages (ESC/POS, ZPL, TSPL, EPL, CPCL), over the network, a serial or Bluetooth port,
       a device file, the system print queue or the Windows spooler; and barcodes. Pure functions where possible, so everything can be tested without a printer. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NextGenOS.Devices</RootNamespace>
    <AssemblyName>NextGenOS.Devices</AssemblyName>
    <Company>NextGenOS</Company>
    <Product>NextGenOS Devices</Product>
    <Copyright>© 2026 NextGenOS. All rights reserved.</Copyright>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.1" />
  </ItemGroup>

</Project>

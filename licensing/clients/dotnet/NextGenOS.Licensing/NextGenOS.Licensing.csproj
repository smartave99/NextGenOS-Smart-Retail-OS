<Project Sdk="Microsoft.NET.Sdk">

  <!-- Signed-licence client for NextGenOS products. net48 for the Windows apps (POS, AI add-on), net8.0 for the dashboard and tests.
       Specification: licensing/spec/LICENCE-FORMAT.md -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>NextGenOS.Licensing</RootNamespace>
    <AssemblyName>NextGenOS.Licensing</AssemblyName>
    <Company>NextGenOS</Company>
    <Product>NextGenOS Licensing</Product>
    <Copyright>© 2026 NextGenOS. All rights reserved.</Copyright>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>

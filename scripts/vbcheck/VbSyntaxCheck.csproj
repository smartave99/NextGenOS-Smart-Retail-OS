<Project Sdk="Microsoft.NET.Sdk">
  <!-- Parses VB.NET files with the compiler that ships in the .NET SDK and reports syntax errors. Not a full build:
       the POS needs its original binaries (Original_Binaries) for that, and a Windows machine. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="4.11.0" />
  </ItemGroup>
</Project>
